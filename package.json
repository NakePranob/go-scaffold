{
  "name": "@nakedev/go-scaffold",
  "version": "0.4.2",
  "description": "Scaffold Gin + GORM + Postgres Go backend projects with a consistent domain-module standard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NakePranob/go-scaffold.git"
  },
  "bin": {
    "go-scaffold": "bin/go-scaffold.js"
  },
  "files": [
    "dist",
    "templates",
    "bin"
  ],
  "type": "commonjs",
  "packageManager": "pnpm@11.0.7",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:smoke",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:e2e:install": "playwright install chromium",
    "verify": "pnpm run build && pnpm run test",
    "release:check": "node scripts/check-release.mjs",
    "policy:main": "node scripts/check-main-merge.mjs",
    "prepack": "rm -rf dist && pnpm run build",
    "prepublishOnly": "pnpm run release:check && pnpm run verify"
  },
  "keywords": [
    "go",
    "gin",
    "gorm",
    "scaffold",
    "cli",
    "generator"
  ],
  "author": "nakedev",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.1",
    "commander": "^15.0.0",
    "fs-extra": "^11.3.0",
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "@types/pluralize": "^0.0.33",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
