ValidationError:
  description: invalid input
  content:
    application/json:
      schema: { $ref: './schemas.yaml#/Error' }
NotFoundError:
  description: not found
  content:
    application/json:
      schema: { $ref: './schemas.yaml#/Error' }
ConflictError:
  description: conflict (duplicate, or resource still referenced)
  content:
    application/json:
      schema: { $ref: './schemas.yaml#/Error' }
UnprocessableEntityError:
  description: input well-formed but references a resource that doesn't exist
  content:
    application/json:
      schema: { $ref: './schemas.yaml#/Error' }
UnauthorizedError:
  description: missing, invalid, or expired credentials
  content:
    application/json:
      schema: { $ref: './schemas.yaml#/Error' }
ForbiddenError:
  description: authenticated but lacking the required permission
  content:
    application/json:
      schema: { $ref: './schemas.yaml#/Error' }
TooManyRequestsError:
  description: rate limit exceeded, retry later
  content:
    application/json:
      schema: { $ref: './schemas.yaml#/Error' }
