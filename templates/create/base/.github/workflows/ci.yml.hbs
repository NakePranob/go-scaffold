name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          # repository integration tests run against this isolated database after
          # applying the same versioned SQL migrations used in production
          POSTGRES_DB: {{dbName}}_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod

      - run: go build ./...

      - run: go vet ./...

      - name: gofmt check
        run: |
          diff <(gofmt -l .) <(printf '')

      - uses: golangci/golangci-lint-action@v6
        with:
          # keep in step with GOLANGCI_LINT_VERSION in the Makefile, so a rule
          # that passes locally passes here too
          version: v2.12.2

{{#if openapiDocs}}
      # catches a broken $ref or malformed spec before it reaches anyone
      # pointing a client generator or Scalar/Swagger UI at this file — those
      # tools often fail with a much less specific error than this gives.
      - name: Lint OpenAPI spec
        run: npx --yes @redocly/cli lint docs/openapi.yaml

{{/if}}
      - name: Install migration runner
        run: go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@v4.19.1

      - name: Apply production migrations to the test database
        env:
          DB_DSN: postgres://postgres:postgres@localhost:5432/{{dbName}}_test?sslmode=disable
        run: |
          if compgen -G "migrations/*.up.sql" > /dev/null; then
            migrate -path migrations -database "$DB_DSN" up
          fi

      - name: Test (required PostgreSQL integration tests cannot skip)
        env:
          TEST_DB_DSN: postgres://postgres:postgres@localhost:5432/{{dbName}}_test?sslmode=disable
          REQUIRE_TEST_DB: "true"
        run: go test ./...
