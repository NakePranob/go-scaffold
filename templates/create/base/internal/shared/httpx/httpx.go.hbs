// ParseID reads the ":id" route param as a UUID — shared by every domain
// whose resource is identified by id.
func ParseID(c *gin.Context) (uuid.UUID, bool) {
	id, err := uuid.Parse(c.Param("id"))
	if err != nil {
		c.Error(apperror.NewValidation("invalid id", nil))
		return uuid.Nil, false
	}
	return id, true
}

// BindErr converts a validator error into a validation payload with a field
// map (shared by every domain).
func BindErr(err error) *apperror.AppError {
	var ve validator.ValidationErrors
	if errors.As(err, &ve) {
		details := make(map[string]string, len(ve))
		for _, fe := range ve {
			details[strings.ToLower(fe.Field())] = fe.Tag()
		}
		return apperror.NewValidation("invalid input", details)
	}
	return apperror.NewValidation("invalid json body", nil)
}

// OK writes a successful single-resource response.
func OK(c *gin.Context, data any) {
{{#if (eq singleShape "data")}}	c.JSON(http.StatusOK, gin.H{"data": data})
{{else}}	c.JSON(http.StatusOK, data)
{{/if}}
}

// Created writes a successful create response.
func Created(c *gin.Context, data any) {
{{#if (eq singleShape "data")}}	c.JSON(http.StatusCreated, gin.H{"data": data})
{{else}}	c.JSON(http.StatusCreated, data)
{{/if}}
}

// NoContent writes a successful response with no body.
func NoContent(c *gin.Context) {
	c.Status(http.StatusNoContent)
	c.Writer.WriteHeaderNow()
}

// Page writes the selected list envelope with the row count the filter
// matched.
func Page(c *gin.Context, p pagination.Params, data any, total int64) {
{{#if (eq listShape "data-meta")}}	c.JSON(http.StatusOK, gin.H{
		"data": data,
		"meta": gin.H{"limit": p.Limit, "offset": p.Offset, "total": total},
	})
{{else if (eq listShape "items-total")}}	c.JSON(http.StatusOK, gin.H{"items": data, "total": total})
{{else}}	c.JSON(http.StatusOK, p.ResponseWithTotal(data, total))
{{/if}}
}
