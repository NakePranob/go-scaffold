// Package httpadapter is the Gin inbound adapter for {{pkg}}.
package httpadapter

import (
	"net/http"

	"{{goModule}}/internal/app/{{modulePath}}/application"
	"{{goModule}}/internal/app/{{modulePath}}/domain"
	"{{goModule}}/internal/app/{{modulePath}}/ports"
	"{{goModule}}/internal/shared/apperror"
	"{{goModule}}/internal/shared/httpx"
{{#if auth}}	"{{goModule}}/internal/shared/middleware"
{{/if}}
	"{{goModule}}/internal/shared/pagination"

	"github.com/gin-gonic/gin"
)

type Handler struct {
{{#if cqrs}}
	commands application.CommandPort
	queries  application.QueryPort
{{else}}
	svc application.ServicePort
{{/if}}
{{#if auth}}
	jwtSecret string
	jwtIssuer string
	jwtAudience string
{{/if}}
{{#if permission}}
	authz *middleware.Authz
{{/if}}
{{#if auth}}
	sessionValidators []middleware.SessionValidator
{{/if}}
}

{{#if cqrs}}
func NewHandler(commands application.CommandPort, queries application.QueryPort{{#if auth}}, jwtSecret string, jwtIssuer string, jwtAudience string{{/if}}{{#if permission}}, authz *middleware.Authz{{/if}}{{#if auth}}, sessionValidators ...middleware.SessionValidator{{/if}}) *Handler {
	h := &Handler{commands: commands, queries: queries}
{{#if auth}}
	h.jwtSecret = jwtSecret
	h.jwtIssuer = jwtIssuer
	h.jwtAudience = jwtAudience
	h.sessionValidators = sessionValidators
{{/if}}
{{#if permission}}
	h.authz = authz
{{/if}}
	return h
}
{{else}}
func NewHandler(svc application.ServicePort{{#if auth}}, jwtSecret string, jwtIssuer string, jwtAudience string{{/if}}{{#if permission}}, authz *middleware.Authz{{/if}}{{#if auth}}, sessionValidators ...middleware.SessionValidator{{/if}}) *Handler {
	h := &Handler{svc: svc}
{{#if auth}}
	h.jwtSecret = jwtSecret
	h.jwtIssuer = jwtIssuer
	h.jwtAudience = jwtAudience
	h.sessionValidators = sessionValidators
{{/if}}
{{#if permission}}
	h.authz = authz
{{/if}}
	return h
}
{{/if}}

func (h *Handler) Register(rg gin.IRouter) {
	g := rg.Group("/{{plural}}"{{#if auth}}, middleware.RequireAuthWithIssuer(h.jwtSecret, h.jwtIssuer, h.jwtAudience, h.sessionValidators...){{/if}}{{#if permission}}, h.authz.Require("{{permission}}"){{/if}})
	g.POST("", h.create)
	g.GET("", h.list)
	g.GET("/:id", h.get)
	g.PUT("/:id", h.update)
	g.DELETE("/:id", h.delete)
	// go-scaffold:handler-routes
}

var httpErrors = []apperror.Rule{
	{Err: domain.ErrNotFound, Status: http.StatusNotFound, Code: "{{errorPrefix}}_NOT_FOUND", Message: "{{pkg}} not found"},
	{Err: domain.ErrConflict, Status: http.StatusConflict, Code: "{{errorPrefix}}_CONFLICT", Message: "{{pkg}} already exists"},
	{Err: domain.ErrStaleVersion, Status: http.StatusConflict, Code: "{{errorPrefix}}_STALE", Message: "{{pkg}} was modified by someone else — reload and try again"},
	{Err: domain.ErrHasReferences, Status: http.StatusConflict, Code: "{{errorPrefix}}_HAS_REFERENCES", Message: "{{pkg}} still has related records"},
	{Err: domain.ErrNotImplemented, Status: http.StatusNotImplemented, Code: "NOT_IMPLEMENTED", Message: "not implemented"},
}

func appError(err error) error {
	return apperror.Translate(err, httpErrors...)
}

func (h *Handler) create(c *gin.Context) {
	var in createInput
	if err := c.ShouldBindJSON(&in); err != nil {
		c.Error(httpx.BindErr(err))
		return
	}
{{#if cqrs}}
	m, err := h.commands.Create(c.Request.Context(), toCreateInput(in))
{{else}}
	m, err := h.svc.Create(c.Request.Context(), toCreateInput(in))
{{/if}}
	if err != nil {
		c.Error(appError(err))
		return
	}
	httpx.Created(c, toResponse(application.ToResponse(m)))
}

func (h *Handler) list(c *gin.Context) {
	p := pagination.Parse(c)
	// One struct all the way down, so this module's own filters are read off
	// the query string here and added as fields on ports.ListFilter — never as
	// extra arguments on the three signatures below.
	filter := ports.ListFilter{
		Search: p.Search,
		Sort:   p.Sort,
		Desc:   p.Desc,
		Limit:  p.Limit,
		Offset: p.Offset,
	}
{{#if cqrs}}
	items, total, err := h.queries.List(c.Request.Context(), filter)
{{else}}
	items, total, err := h.svc.List(c.Request.Context(), filter)
{{/if}}
	if err != nil {
		c.Error(appError(err))
		return
	}
	out := make([]response, len(items))
	for i := range items {
		out[i] = toResponse(application.ToResponse(&items[i]))
	}
	httpx.Page(c, p, out, total)
}

func (h *Handler) get(c *gin.Context) {
	id, ok := httpx.ParseID(c)
	if !ok {
		return
	}
{{#if cqrs}}
	m, err := h.queries.Get(c.Request.Context(), id)
{{else}}
	m, err := h.svc.Get(c.Request.Context(), id)
{{/if}}
	if err != nil {
		c.Error(appError(err))
		return
	}
	httpx.OK(c, toResponse(application.ToResponse(m)))
}

func (h *Handler) update(c *gin.Context) {
	id, ok := httpx.ParseID(c)
	if !ok {
		return
	}
	var in updateInput
	if err := c.ShouldBindJSON(&in); err != nil {
		c.Error(httpx.BindErr(err))
		return
	}
{{#if cqrs}}
	m, err := h.commands.Update(c.Request.Context(), id, toUpdateInput(in))
{{else}}
	m, err := h.svc.Update(c.Request.Context(), id, toUpdateInput(in))
{{/if}}
	if err != nil {
		c.Error(appError(err))
		return
	}
	httpx.OK(c, toResponse(application.ToResponse(m)))
}

func (h *Handler) delete(c *gin.Context) {
	id, ok := httpx.ParseID(c)
	if !ok {
		return
	}
{{#if cqrs}}
	err := h.commands.Delete(c.Request.Context(), id)
{{else}}
	err := h.svc.Delete(c.Request.Context(), id)
{{/if}}
	if err != nil {
		c.Error(appError(err))
		return
	}
	httpx.NoContent(c)
}

// go-scaffold:handler-funcs
