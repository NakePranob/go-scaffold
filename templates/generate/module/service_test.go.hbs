package {{pkg}}

import (
	"context"
	"errors"
	"testing"

	"{{goModule}}/internal/app/{{modulePath}}/model"
	"{{goModule}}/internal/shared/apperror"

	"github.com/google/uuid"
	"gorm.io/gorm"
