parameters:
  - $ref: '../common/parameters.yaml#/IdParam'
patch:
  summary: Enable or disable a user account
  description: Requires recent authentication. Disabling revokes every active refresh session before the account state changes; re-enabling never creates a session.
  operationId: setUserAccountStatus
  tags: [rbac]
  security: [{ bearerAuth: [] }]
  requestBody:
    required: true
    content:
      application/json:
        schema: { $ref: './schemas.yaml#/SetAccountStatusInput' }
  responses:
    "200":
      description: updated
      content:
        application/json:
          schema: { $ref: '../auth/schemas.yaml#/MeResponse' }
    "400": { $ref: '../common/responses.yaml#/ValidationError' }
    "401": { $ref: '../common/responses.yaml#/UnauthorizedError' }
    "403": { $ref: '../common/responses.yaml#/ForbiddenError' }
    "404": { $ref: '../common/responses.yaml#/NotFoundError' }
