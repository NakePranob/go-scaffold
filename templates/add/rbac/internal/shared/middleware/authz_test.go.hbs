func TestAuthz_CachesWithinTTL(t *testing.T) {
	var calls int32
	a := NewAuthz(func(context.Context, string) (map[string]struct{}, error) {
		atomic.AddInt32(&calls, 1)
		return map[string]struct{}{"x": {}}, nil
	}, time.Minute)

	if _, err := a.permsOf(context.Background(), "staff"); err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if _, err := a.permsOf(context.Background(), "staff"); err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if got := atomic.LoadInt32(&calls); got != 1 {
		t.Fatalf("want resolve called once for two calls within TTL (cache hit), got %d", got)
	}
}

func TestAuthz_ReResolvesAfterTTLExpires(t *testing.T) {
	var calls int32
	a := NewAuthz(func(context.Context, string) (map[string]struct{}, error) {
		atomic.AddInt32(&calls, 1)
		return map[string]struct{}{"x": {}}, nil
	}, 10*time.Millisecond)

	if _, err := a.permsOf(context.Background(), "staff"); err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	time.Sleep(20 * time.Millisecond)
	if _, err := a.permsOf(context.Background(), "staff"); err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if got := atomic.LoadInt32(&calls); got != 2 {
		t.Fatalf("want resolve called again once the TTL expires, got %d calls", got)
	}
}

func TestAuthz_Require_ForbidsMissingPermission(t *testing.T) {
	gin.SetMode(gin.TestMode)
	a := NewAuthz(func(context.Context, string) (map[string]struct{}, error) {
		return map[string]struct{}{"other:perm": {}}, nil
	}, time.Minute)

	r := gin.New()
	// Require only records a *apperror.AppError via c.Error — Error(true) is
	// what actually translates that into the response status code, same as
	// the real router (see cmd/api/wiring.go).
	r.Use(Error(true))
	r.GET("/x", func(c *gin.Context) { c.Set(RoleKey, "staff") }, a.Require("role:manage"), func(c *gin.Context) {
		c.Status(http.StatusOK)
	})
	w := httptest.NewRecorder()
	r.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/x", nil))
	if w.Code != http.StatusForbidden {
		t.Fatalf("want 403 without the required permission, got %d", w.Code)
	}
}

func TestAuthz_Require_AllowsGrantedPermission(t *testing.T) {
	gin.SetMode(gin.TestMode)
	a := NewAuthz(func(context.Context, string) (map[string]struct{}, error) {
		return map[string]struct{}{"role:manage": {}}, nil
	}, time.Minute)

	r := gin.New()
	r.Use(Error(true))
	r.GET("/x", func(c *gin.Context) { c.Set(RoleKey, "admin") }, a.Require("role:manage"), func(c *gin.Context) {
		c.Status(http.StatusOK)
	})
	w := httptest.NewRecorder()
	r.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/x", nil))
	if w.Code != http.StatusOK {
		t.Fatalf("want 200 with the required permission granted, got %d", w.Code)
	}
}

func TestVersionedAuthz_ReResolvesWhenRoleVersionChanges(t *testing.T) {
	var calls int32
	version := time.Unix(1, 0)
	a := NewVersionedAuthz(func(context.Context, string) (map[string]struct{}, error) {
		atomic.AddInt32(&calls, 1)
		return map[string]struct{}{"x": {}}, nil
	}, func(context.Context, string) (time.Time, error) {
		return version, nil
	}, time.Hour)

	if _, err := a.permsOf(context.Background(), "staff"); err != nil {
		t.Fatalf("first permission read: %v", err)
	}
	if _, err := a.permsOf(context.Background(), "staff"); err != nil {
		t.Fatalf("cached permission read: %v", err)
	}
	version = time.Unix(2, 0)
	if _, err := a.permsOf(context.Background(), "staff"); err != nil {
		t.Fatalf("versioned permission read: %v", err)
	}
	if got := atomic.LoadInt32(&calls); got != 2 {
		t.Fatalf("want one resolve per role version, got %d", got)
	}
}

func TestVersionedAuthz_InvalidatesAcrossTwoInstances(t *testing.T) {
	version := time.Unix(10, 0)
	var calls int32
	resolve := func(context.Context, string) (map[string]struct{}, error) {
		atomic.AddInt32(&calls, 1)
		return map[string]struct{}{"x": {}}, nil
	}
	readVersion := func(context.Context, string) (time.Time, error) { return version, nil }
	first := NewVersionedAuthz(resolve, readVersion, time.Hour)
	second := NewVersionedAuthz(resolve, readVersion, time.Hour)
	if _, err := first.permsOf(context.Background(), "admin"); err != nil {
		t.Fatalf("first instance warm: %v", err)
	}
	if _, err := second.permsOf(context.Background(), "admin"); err != nil {
		t.Fatalf("second instance warm: %v", err)
	}
	version = time.Unix(11, 0)
	if _, err := second.permsOf(context.Background(), "admin"); err != nil {
		t.Fatalf("second instance after shared version change: %v", err)
	}
	if _, err := first.permsOf(context.Background(), "admin"); err != nil {
		t.Fatalf("first instance after shared version change: %v", err)
	}
	if got := atomic.LoadInt32(&calls); got != 4 {
		t.Fatalf("both instances must resolve once per version, got %d calls", got)
	}
}

func TestVersionedAuthz_FailsClosedWhenVersionReadFails(t *testing.T) {
	want := errors.New("database unavailable")
	a := NewVersionedAuthz(func(context.Context, string) (map[string]struct{}, error) {
		t.Fatal("resolve must not run when version cannot be read")
		return nil, nil
	}, func(context.Context, string) (time.Time, error) { return time.Time{}, want }, time.Hour)
	if _, err := a.permsOf(context.Background(), "staff"); !errors.Is(err, want) {
		t.Fatalf("version read error = %v, want %v", err, want)
	}
}
