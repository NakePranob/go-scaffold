package application

import (
	"time"

	"{{goModule}}/internal/app/role/domain"
)

const PermRoleManage = "role:manage"

type CreateInput struct {
	Code string
	Name string
}

type SetPermissionsInput struct {
	PermissionCodes *[]string
}

type RoleListItem struct {
	Role        domain.Role
	Permissions []string
}

type RoleResponse struct {
	Code        string
	Name        string
	IsSystem    bool
	Permissions []string
	CreatedAt   time.Time
}

type PermissionResponse struct {
	Code        string
	Description string
}

func ToRoleResponse(item RoleListItem) RoleResponse {
	return RoleResponse{
		Code: item.Role.Code, Name: item.Role.Name, IsSystem: item.Role.IsSystem,
		Permissions: item.Permissions, CreatedAt: item.Role.CreatedAt,
	}
}

func ToPermissionResponse(item domain.Permission) PermissionResponse {
	return PermissionResponse{Code: item.Code, Description: item.Description}
}
