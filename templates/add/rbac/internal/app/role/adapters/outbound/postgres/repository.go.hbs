package postgres

import (
	"context"
	"errors"

	"{{goModule}}/internal/app/role/domain"
	"{{goModule}}/internal/app/role/ports"
	"{{goModule}}/internal/shared/dberr"
	"{{goModule}}/internal/shared/tx"

	"gorm.io/gorm"
)

var _ ports.Repository = (*Repository)(nil)

type Repository struct {
	db *gorm.DB
}

func NewRepository(db *gorm.DB) *Repository { return &Repository{db: db} }

func (r *Repository) PermissionCodes(ctx context.Context, roleCode string) ([]string, error) {
	var codes []string
	err := tx.From(ctx, r.db).WithContext(ctx).
		Model(&RolePermission{}).Where("role_code = ?", roleCode).Pluck("permission_code", &codes).Error
	return codes, mapDatabaseError(err)
}

func (r *Repository) FindAll(ctx context.Context, limit, offset int) ([]domain.Role, error) {
	var rows []Role
	err := tx.From(ctx, r.db).WithContext(ctx).Order("code").Limit(limit).Offset(offset).Find(&rows).Error
	if err != nil {
		return nil, mapDatabaseError(err)
	}
	items := make([]domain.Role, len(rows))
	for i := range rows {
		items[i] = toDomainRole(&rows[i])
	}
	return items, nil
}

func (r *Repository) FindByCode(ctx context.Context, code string) (*domain.Role, error) {
	var row Role
	if err := tx.From(ctx, r.db).WithContext(ctx).First(&row, "code = ?", code).Error; err != nil {
		return nil, mapDatabaseError(err)
	}
	value := toDomainRole(&row)
	return &value, nil
}

func (r *Repository) Create(ctx context.Context, role *domain.Role) error {
	return mapDatabaseError(tx.From(ctx, r.db).WithContext(ctx).Create(fromDomainRole(role)).Error)
}

func (r *Repository) SetPermissions(ctx context.Context, roleCode string, permissionCodes []string) error {
	return tx.Do(ctx, r.db, func(txctx context.Context) error {
		db := tx.From(txctx, r.db).WithContext(txctx)
		if err := db.Where("role_code = ?", roleCode).Delete(&RolePermission{}).Error; err != nil {
			return mapDatabaseError(err)
		}
		if len(permissionCodes) == 0 {
			return nil
		}
		grants := make([]RolePermission, len(permissionCodes))
		for i, code := range permissionCodes {
			grants[i] = RolePermission{RoleCode: roleCode, PermissionCode: code}
		}
		return mapDatabaseError(db.Create(&grants).Error)
	})
}

func (r *Repository) Delete(ctx context.Context, code string) error {
	result := tx.From(ctx, r.db).WithContext(ctx).Where("code = ?", code).Delete(&Role{})
	if result.Error != nil {
		if dberr.IsForeignKey(result.Error) {
			return domain.ErrHasReferences
		}
		return mapDatabaseError(result.Error)
	}
	if result.RowsAffected == 0 {
		return domain.ErrNotFound
	}
	return nil
}

func (r *Repository) FindAllPermissions(ctx context.Context, limit, offset int) ([]domain.Permission, error) {
	var rows []Permission
	err := tx.From(ctx, r.db).WithContext(ctx).Order("code").Limit(limit).Offset(offset).Find(&rows).Error
	if err != nil {
		return nil, mapDatabaseError(err)
	}
	items := make([]domain.Permission, len(rows))
	for i := range rows {
		items[i] = toDomainPermission(&rows[i])
	}
	return items, nil
}

func (r *Repository) AllPermissionCodes(ctx context.Context) ([]string, error) {
	var codes []string
	err := tx.From(ctx, r.db).WithContext(ctx).Model(&Permission{}).Pluck("code", &codes).Error
	return codes, mapDatabaseError(err)
}

func (r *Repository) CountRolesWithPermission(ctx context.Context, permissionCode, excludeCode string) (int64, error) {
	var count int64
	err := tx.From(ctx, r.db).WithContext(ctx).Model(&RolePermission{}).
		Where("permission_code = ? AND role_code <> ?", permissionCode, excludeCode).Count(&count).Error
	return count, mapDatabaseError(err)
}

func mapDatabaseError(err error) error {
	if err == nil {
		return nil
	}
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return domain.ErrNotFound
	}
	if dberr.IsDuplicate(err) {
		return domain.ErrConflict
	}
	if dberr.IsForeignKey(err) {
		return domain.ErrUnknownPermission
	}
	return err
}
