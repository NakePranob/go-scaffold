// Package httpadapter is role's inbound HTTP boundary. It owns route,
// authentication middleware, request binding, response DTOs, and translation
// from application errors to the API error envelope.
package httpadapter

import (
	"errors"
	"net/http"

	"{{goModule}}/internal/app/role/application"
	"{{goModule}}/internal/app/role/domain"
	"{{goModule}}/internal/app/role/ports"
	"{{goModule}}/internal/shared/apperror"
	"{{goModule}}/internal/shared/httpx"
	"{{goModule}}/internal/shared/middleware"
	"{{goModule}}/internal/shared/pagination"

	"github.com/gin-gonic/gin"
)

type Handler struct {
	svc       application.ServicePort
	jwtSecret string
	jwtIssuer string
	jwtAudience string
	authz             *middleware.Authz
	sessionValidators []middleware.SessionValidator
}

func NewHandler(svc application.ServicePort, jwtSecret string, jwtIssuer string, jwtAudience string, authz *middleware.Authz, sessionValidators ...middleware.SessionValidator) *Handler {
	return &Handler{svc: svc, jwtSecret: jwtSecret, jwtIssuer: jwtIssuer, jwtAudience: jwtAudience, authz: authz, sessionValidators: sessionValidators}
}

func (h *Handler) Register(rg gin.IRouter) {
	roles := rg.Group("/roles", middleware.RequireAuthWithIssuer(h.jwtSecret, h.jwtIssuer, h.jwtAudience, h.sessionValidators...), h.authz.Require(application.PermRoleManage))
	roles.GET("", h.list)
	roles.POST("", h.create)
	roles.PATCH("/:code/permissions", h.setPermissions)
	roles.DELETE("/:code", h.delete)

	perms := rg.Group("/permissions", middleware.RequireAuthWithIssuer(h.jwtSecret, h.jwtIssuer, h.jwtAudience, h.sessionValidators...), h.authz.Require(application.PermRoleManage))
	perms.GET("", h.listPermissions)
}

func (h *Handler) list(c *gin.Context) {
	p := pagination.Parse(c)
	// One struct all the way down, so a filter added later is a field on
	// ports.ListFilter and not a new argument on the three signatures below.
	filter := ports.ListFilter{Search: p.Search, Limit: p.Limit, Offset: p.Offset}
	items, total, err := h.svc.List(c.Request.Context(), filter)
	if err != nil {
		c.Error(appError(err))
		return
	}
	out := make([]roleResponse, len(items))
	for i := range items {
		out[i] = toRoleResponse(application.ToRoleResponse(items[i]))
	}
	httpx.Page(c, p, out, total)
}

func (h *Handler) create(c *gin.Context) {
	var in createInput
	if err := c.ShouldBindJSON(&in); err != nil {
		c.Error(httpx.BindErr(err))
		return
	}
	item, err := h.svc.Create(c.Request.Context(), toCreateInput(in))
	if err != nil {
		c.Error(appError(err))
		return
	}
	httpx.Created(c, toRoleResponse(application.ToRoleResponse(*item)))
}

func (h *Handler) setPermissions(c *gin.Context) {
	var in setPermissionsInput
	if err := c.ShouldBindJSON(&in); err != nil {
		c.Error(httpx.BindErr(err))
		return
	}
	appInput := toSetPermissionsInput(in)
	if appInput.PermissionCodes == nil {
		c.Error(apperror.NewValidation("invalid role input", map[string]string{"permission_codes": "is required"}))
		return
	}
	item, err := h.svc.SetPermissions(c.Request.Context(), c.Param("code"), *appInput.PermissionCodes)
	if err != nil {
		c.Error(appError(err))
		return
	}
	h.authz.Invalidate(item.Role.Code)
	httpx.OK(c, toRoleResponse(application.ToRoleResponse(*item)))
}

func (h *Handler) delete(c *gin.Context) {
	if err := h.svc.Delete(c.Request.Context(), c.Param("code")); err != nil {
		c.Error(appError(err))
		return
	}
	h.authz.Invalidate(c.Param("code"))
	httpx.NoContent(c)
}

func (h *Handler) listPermissions(c *gin.Context) {
	p := pagination.Parse(c)
	items, err := h.svc.ListPermissions(c.Request.Context(), p.Limit, p.Offset)
	if err != nil {
		c.Error(appError(err))
		return
	}
	out := make([]permissionResponse, len(items))
	for i := range items {
		out[i] = toPermissionResponse(application.ToPermissionResponse(items[i]))
	}
	httpx.OK(c, p.Response(out))
}

var httpStatusForRule = []struct {
	Err    error
	Status int
}{
	{domain.ErrNotFound, http.StatusNotFound},
	{domain.ErrConflict, http.StatusConflict},
	{domain.ErrHasReferences, http.StatusConflict},
	{domain.ErrSystemRole, http.StatusConflict},
	{domain.ErrLastRoleManager, http.StatusConflict},
}

var httpErrors = []apperror.Rule{
	{Err: domain.ErrNotFound, Status: http.StatusNotFound, Code: "ROLE_NOT_FOUND", Message: "role not found"},
	{Err: domain.ErrConflict, Status: http.StatusConflict, Code: "ROLE_CONFLICT", Message: "role conflict"},
	{Err: domain.ErrHasReferences, Status: http.StatusConflict, Code: "ROLE_HAS_REFERENCES", Message: "role still has users assigned to it"},
	{Err: domain.ErrUnknownPermission, Status: http.StatusUnprocessableEntity, Code: "ROLE_UNKNOWN_PERMISSION", Message: "one or more permission codes do not exist"},
}

func appError(err error) error {
	if err == nil {
		return nil
	}
	var rule *domain.RuleError
	if errors.As(err, &rule) {
		status := http.StatusUnprocessableEntity
		for _, entry := range httpStatusForRule {
			if errors.Is(err, entry.Err) {
				status = entry.Status
				break
			}
		}
		return apperror.New(status, rule.Code, rule.Message)
	}
	return apperror.Translate(err, httpErrors...)
}
