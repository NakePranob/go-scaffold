// Client sends plain-text email over SMTP. Production requires STARTTLS before
// authentication or envelope commands; development may use a local catcher
// that does not advertise TLS.
type Client struct {
	host, port, username, password, from string
	requireStartTLS bool
	slots chan struct{}
}

const (
	smtpSendTimeout      = 10 * time.Second
	maxConcurrentSMTP    = 16
)

func Open(cfg config.Config) *Client {
	return &Client{
		host:     cfg.SMTPHost,
		port:     cfg.SMTPPort,
		username: cfg.SMTPUsername,
		password: cfg.SMTPPassword,
		from:     cfg.SMTPFrom,
		requireStartTLS: cfg.IsProd(),
		slots:    make(chan struct{}, maxConcurrentSMTP),
	}
}

// Send delivers a rendered message. If SMTP isn't configured (dev default —
// SMTP_HOST unset), it logs only non-sensitive metadata instead of the body.
// Recovery and verification bodies contain bearer links and must never enter
// application logs.
func (c *Client) Send(to string, m emails.Message) error {
	return c.SendContext(context.Background(), to, m)
}

// SendContext bounds SMTP connection and protocol I/O and interrupts a
// blocked connection when the request is canceled. The production client also
// limits concurrent SMTP calls so unauthenticated mail endpoints cannot pin an
// unbounded number of handler goroutines behind a stalled relay.
func (c *Client) SendContext(ctx context.Context, to string, m emails.Message) error {
	// build() skips a part whose body is empty, so a Message with neither half
	// would go out as a multipart/alternative containing no parts at all —
	// which every client renders as a blank mail. Refusing here leaves the job
	// failed and visible instead of delivered and silent.
	if m.Text == "" && m.HTML == "" {
		return fmt.Errorf("refusing to send an email with no body (subject %q)", m.Subject)
	}
	if c.host == "" {
		slog.Info("email not sent (SMTP not configured)", "to", to, "subject", m.Subject)
		return nil
	}
	if strings.ContainsAny(to, "\r\n") {
		return fmt.Errorf("refusing to send an email with an invalid recipient")
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	if c.slots != nil {
		select {
		case c.slots <- struct{}{}:
			defer func() { <-c.slots }()
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	// ParseAddress so SMTP_FROM can carry a display name. The envelope needs
	// the bare address — a relay handed `Name <a@b.com>` in MAIL FROM rejects
	// the whole message — while the header keeps the name.
	from, err := mail.ParseAddress(c.from)
	if err != nil {
		return fmt.Errorf("parse SMTP_FROM: %w", err)
	}
	msg, err := build(from.String(), to, m)
	if err != nil {
		return err
	}
	// nil Auth when no username is set — a relay/local catcher that doesn't
	// require auth (or doesn't advertise AUTH at all) rejects a non-nil Auth
	// outright, even with empty credentials.
	var auth smtp.Auth
	if c.username != "" {
		auth = smtp.PlainAuth("", c.username, c.password, c.host)
	}
	return c.sendSMTP(ctx, from.Address, to, auth, msg)
}

func (c *Client) sendSMTP(ctx context.Context, from, to string, auth smtp.Auth, msg []byte) error {
	deadlineCtx, cancel := context.WithTimeout(ctx, smtpSendTimeout)
	defer cancel()
	conn, err := (&net.Dialer{Timeout: smtpSendTimeout}).DialContext(deadlineCtx, "tcp", net.JoinHostPort(c.host, c.port))
	if err != nil {
		return err
	}
	defer func() { _ = conn.Close() }()
	if deadline, ok := deadlineCtx.Deadline(); ok {
		_ = conn.SetDeadline(deadline)
	}
	interrupt := make(chan struct{})
	defer close(interrupt)
	go func() {
		select {
		case <-deadlineCtx.Done():
			_ = conn.SetDeadline(time.Now())
		case <-interrupt:
		}
	}()

	client, err := smtp.NewClient(conn, c.host)
	if err != nil {
		return err
	}
	defer func() { _ = client.Close() }()
	if err := client.Hello("localhost"); err != nil {
		return err
	}
	if ok, _ := client.Extension("STARTTLS"); ok {
		if err := client.StartTLS(&tls.Config{ServerName: c.host, MinVersion: tls.VersionTLS12}); err != nil {
			return err
		}
	} else if c.requireStartTLS {
		return fmt.Errorf("smtp: relay does not support STARTTLS; refusing plaintext delivery in production")
	}
	if auth != nil {
		if ok, _ := client.Extension("AUTH"); !ok {
			return fmt.Errorf("smtp: server does not support AUTH")
		}
		if err := client.Auth(auth); err != nil {
			return err
		}
	}
	if err := client.Mail(from); err != nil {
		return err
	}
	if err := client.Rcpt(to); err != nil {
		return err
	}
	writer, err := client.Data()
	if err != nil {
		return err
	}
	if _, err := writer.Write(msg); err != nil {
		return err
	}
	if err := writer.Close(); err != nil {
		return err
	}
	return client.Quit()
}

// build assembles a multipart/alternative message: plain text first, HTML
// second, which is the order the spec uses to mean "prefer the last one you
// can render". Sending HTML alone is a spam signal on its own, and leaves
// nothing for a text-only client.
func build(from, to string, m emails.Message) ([]byte, error) {
	var buf bytes.Buffer
	parts := multipart.NewWriter(&buf)
	// Date is required by RFC 5322 and a missing one is a spam signal; the
	// subject is Q-encoded because copy is free to be non-ASCII.
	fmt.Fprintf(&buf, "From: %s\r\nTo: %s\r\nSubject: %s\r\nDate: %s\r\nMIME-Version: 1.0\r\nContent-Type: multipart/alternative; boundary=%s\r\n\r\n",
		from, to, mime.QEncoding.Encode("utf-8", m.Subject), time.Now().Format(time.RFC1123Z), parts.Boundary())
	for _, part := range []struct{ contentType, body string }{
		{"text/plain; charset=UTF-8", m.Text},
		{"text/html; charset=UTF-8", m.HTML},
	} {
		if part.body == "" {
			continue
		}
		w, err := parts.CreatePart(textproto.MIMEHeader{
			"Content-Type":              {part.contentType},
			"Content-Transfer-Encoding": {"quoted-printable"},
		})
		if err != nil {
			return nil, fmt.Errorf("build email part: %w", err)
		}
		// quoted-printable keeps 8-bit copy intact over a 7-bit path and wraps
		// the long lines HTML is full of; SMTP rejects lines over 998.
		qp := quotedprintable.NewWriter(w)
		if _, err := qp.Write([]byte(part.body)); err != nil {
			return nil, fmt.Errorf("encode email part: %w", err)
		}
		if err := qp.Close(); err != nil {
			return nil, fmt.Errorf("encode email part: %w", err)
		}
	}
	if err := parts.Close(); err != nil {
		return nil, fmt.Errorf("close email parts: %w", err)
	}
	return buf.Bytes(), nil
}

// SyncClient sends in the caller's goroutine, satisfying the same mailer
// interface AsyncClient does. Auth always uses it because recovery and
// verification messages contain bearer links that must not be persisted in a
// generic queue payload. The worker remains available for other job kinds.
//
// The request remains synchronous so bearer links never enter generic queue
// payloads, but the mail client applies a deadline and bounded concurrency.
type SyncClient struct{ c *Client }

func NewSyncClient(c *Client) *SyncClient { return &SyncClient{c: c} }

func (c *SyncClient) Send(ctx context.Context, to string, m emails.Message) error {
	return c.c.SendContext(ctx, to, m)
}
