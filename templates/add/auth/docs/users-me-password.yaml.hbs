post:
  summary: Change the current user's password
  description: Requires the X-Reauth-Token proof from POST /users/me/reauth. Changing the password revokes all refresh-token sessions.
  operationId: changeMyPassword
  tags: [users]
  security: [{ bearerAuth: [] }]
  parameters:
    - name: X-Reauth-Token
      in: header
      required: true
      schema: { type: string, minLength: 1 }
  requestBody:
    required: true
    content:
      application/json:
        schema: { $ref: './schemas.yaml#/ChangePasswordInput' }
  responses:
    "204": { description: password changed and refresh sessions revoked }
    "400": { $ref: '../common/responses.yaml#/ValidationError' }
    "401": { $ref: '../common/responses.yaml#/UnauthorizedError' }
    "403": { $ref: '../common/responses.yaml#/ForbiddenError' }
