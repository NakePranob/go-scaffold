post:
  summary: Reset a password using a reset token
  description: The token is consumed and the password update is committed in one transaction, which also invalidates other outstanding reset links. Refresh sessions are revoked afterward; if the session store is temporarily unavailable, the internal error response restores the token only when no newer reset link was issued, so the caller can retry without reviving an older link over a newer one.
  operationId: resetPassword
  tags: [auth]
  security: []
  requestBody:
    required: true
    content:
      application/json:
        schema: { $ref: './schemas.yaml#/ResetPasswordInput' }
  responses:
    "204": { description: password reset }
    "400": { $ref: '../common/responses.yaml#/ValidationError' }
    "401": { $ref: '../common/responses.yaml#/UnauthorizedError' }
    "429": { $ref: '../common/responses.yaml#/TooManyRequestsError' }
