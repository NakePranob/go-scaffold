post:
  summary: Log out the current session
  description: Revokes the refresh_token cookie's session and clears the cookie. A missing or already-revoked session is idempotent; storage failures are reported so the caller does not mistake an unconfirmed revocation for success.
  operationId: logoutUser
  tags: [auth]
  security: []
  responses:
    "204": { description: logged out }
    "500": { description: session revocation could not be confirmed }
