RegisterInput:
  type: object
  required: [email, password, name]
  properties:
    email: { type: string, format: email }
    password: { type: string, format: password, minLength: 8 }
    name: { type: string }

LoginInput:
  type: object
  required: [email, password]
  properties:
    email: { type: string, format: email }
    password: { type: string, format: password }

ForgotPasswordInput:
  type: object
  required: [email]
  properties:
    email: { type: string, format: email }

ResetPasswordInput:
  type: object
  required: [token, new_password]
  properties:
    token: { type: string }
    new_password: { type: string, format: password, minLength: 8 }

VerifyEmailInput:
  type: object
  required: [token]
  properties:
    token: { type: string }

MFAChallengeInput:
  type: object
  required: [challenge, code]
  additionalProperties: false
  properties:
    challenge: { type: string, minLength: 1 }
    code: { type: string, minLength: 6, maxLength: 16 }

MFACodeInput:
  type: object
  required: [code]
  additionalProperties: false
  properties:
    code: { type: string, minLength: 6, maxLength: 16 }

MFAChallengeResponse:
  type: object
  required: [mfa_required, challenge]
  properties:
    mfa_required: { type: boolean, example: true }
    challenge: { type: string }

MFAStatus:
  type: object
  required: [available, enabled]
  properties:
    available: { type: boolean }
    enabled: { type: boolean }

MFASetupResponse:
  type: object
  required: [secret, otpauth_uri]
  properties:
    secret: { type: string, description: show once and add to an authenticator app }
    otpauth_uri: { type: string, format: uri }

MFAConfirmResponse:
  type: object
  required: [recovery_codes]
  properties:
    recovery_codes:
      type: array
      items: { type: string }

OAuthExchangeInput:
  type: object
  required: [code, state, code_verifier]
  additionalProperties: false
  properties:
    code: { type: string, minLength: 1 }
    state: { type: string, minLength: 1 }
    code_verifier:
      type: string
      minLength: 43
      maxLength: 128
      pattern: '^[A-Za-z0-9._~-]+$'

# access_token in the body; refresh_token is set as an httpOnly cookie, never
# echoed back — see toCookieResponse in internal/app/user/dto.go. All token
# responses carry Cache-Control: no-store and Pragma: no-cache.
AuthResponse:
  type: object
  properties:
    access_token: { type: string }
    token_type: { type: string, example: Bearer }
    expires_in: { type: integer, description: seconds until access_token expires }

MessageResponse:
  type: object
  properties:
    message: { type: string }

MeResponse:
  type: object
  properties:
    id: { type: string, format: uuid }
    email: { type: string, format: email }
    name: { type: string }
    avatar_url: { type: string }
    email_verified: { type: boolean }
    # go-scaffold:me-response-fields
    created_at: { type: string, format: date-time }

SessionResponse:
  type: object
  required: [id, user_agent, created_at, last_used_at, expires_at, current]
  properties:
    id: { type: string, format: uuid }
    user_agent: { type: string, description: browser or client User-Agent captured at sign-in }
    created_at: { type: string, format: date-time }
    last_used_at: { type: string, format: date-time }
    expires_at: { type: string, format: date-time }
    current: { type: boolean, description: true when this session issued the current access token }

SessionsResponse:
  type: object
  required: [sessions]
  properties:
    sessions:
      type: array
      items: { $ref: '#/SessionResponse' }

IdentityResponse:
  type: object
  required: [id, provider, created_at]
  properties:
    id: { type: string, format: uuid }
    provider: { type: string, example: google }
    created_at: { type: string, format: date-time }

IdentitiesResponse:
  type: object
  required: [identities]
  properties:
    identities:
      type: array
      items: { $ref: '#/IdentityResponse' }

IdentityLinkStartInput:
  type: object
  required: [state, code_challenge, code_challenge_method]
  additionalProperties: false
  properties:
    state: { type: string, minLength: 1 }
    code_challenge:
      type: string
      minLength: 43
      maxLength: 128
      pattern: '^[A-Za-z0-9._~-]+$'
    code_challenge_method: { type: string, enum: [S256] }

IdentityLinkStartResponse:
  type: object
  required: [authorization_url]
  properties:
    authorization_url: { type: string, format: uri }
