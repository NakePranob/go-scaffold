package model

import (
	"time"

	"github.com/google/uuid"
)

type Provider string

const ProviderLocal Provider = "local"

// Identity = how you log in (one row per login method). PasswordHash is set
// for a "local" identity; other providers (added later, e.g. "google") would
// carry a ProviderUID instead. Split from User so adding a login method
// never touches the profile row.
type Identity struct {
	ID           uuid.UUID `json:"id" gorm:"type:uuid;primaryKey"`
	UserID       uuid.UUID `json:"user_id" gorm:"type:uuid;not null;uniqueIndex:idx_identities_user_provider,priority:1"`
	Provider     Provider  `json:"provider" gorm:"type:varchar(20);not null;uniqueIndex:idx_identities_user_provider,priority:2"`
	PasswordHash *string   `json:"-"`
	CreatedAt    time.Time `json:"created_at"`
	UpdatedAt    time.Time `json:"updated_at"`
}
