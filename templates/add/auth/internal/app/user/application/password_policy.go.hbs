package application

import (
	"strings"

	"{{goModule}}/internal/app/user/ports"
)

type commonPasswordPolicy struct{}

// NewCommonPasswordPolicy is the generated L1 baseline. Projects with an L2
// profile compose it with the operator's breached-password denylist adapter at
// the composition root.
func NewCommonPasswordPolicy() ports.PasswordPolicy {
	return commonPasswordPolicy{}
}

func (commonPasswordPolicy) Validate(password string) error {
	if err := validatePasswordShape(password); err != nil {
		return err
	}
	if _, found := commonPasswords[strings.ToLower(strings.TrimSpace(password))]; found {
		return errInvalidPassword()
	}
	return nil
}

type compositePasswordPolicy struct {
	base  ports.PasswordPolicy
	extra ports.PasswordPolicy
}

func NewCompositePasswordPolicy(base, extra ports.PasswordPolicy) ports.PasswordPolicy {
	return compositePasswordPolicy{base: base, extra: extra}
}

func (p compositePasswordPolicy) Validate(password string) error {
	if err := p.base.Validate(password); err != nil {
		return err
	}
	if err := p.extra.Validate(password); err != nil {
		return errInvalidPassword()
	}
	return nil
}

func validatePasswordShape(password string) error {
	length := len([]byte(password))
	if length < 8 || length > 256 {
		return errInvalidPassword()
	}
	return nil
}

// This deliberately small, readable baseline catches the most frequently
