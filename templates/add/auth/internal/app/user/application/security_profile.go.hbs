package application

import "errors"

// SecurityProfile is generated from the selected ASVS level. It is runtime
// policy, not a certification result: the deployed application still needs
// the operator-supplied configuration and evidence described in the docs.
type SecurityProfile struct {
	Version                         string
	Level                           int
	CommonPasswordScreening        bool
	ContextPasswordScreening       bool
	BreachedPasswordScreening      bool
	RequireMFAForSensitiveActions  bool
	RequireMFAForApplicationAccess bool
	PhishingResistantMFA           bool
	SuspiciousLoginNotifications   bool
}

func GeneratedSecurityProfile() SecurityProfile {
	return SecurityProfile{
		Version:                        "5.0.0",
		Level:                          {{asvsLevel}},
		CommonPasswordScreening:       true,
		ContextPasswordScreening:      {{#if asvsL2}}true{{else}}false{{/if}},
		BreachedPasswordScreening:     {{#if asvsL2}}true{{else}}false{{/if}},
		RequireMFAForSensitiveActions: {{#if asvsL2}}true{{else}}false{{/if}},
		RequireMFAForApplicationAccess: {{#if asvsL2}}true{{else}}false{{/if}},
		PhishingResistantMFA:          false,
		SuspiciousLoginNotifications:  false,
	}
}

// ValidateRuntime keeps a generated L2 profile from silently degrading in
// production when its operator-owned controls were never configured. Local
// development is intentionally allowed to start so a fresh scaffold remains
// inspectable before deployment secrets and policy data exist.
func (p SecurityProfile) ValidateRuntime(production, mfaEnabled, commonPasswordListConfigured, contextPasswordListConfigured, breachListConfigured, requireMFAForApplicationAccess bool) error {
	if p.CommonPasswordScreening && production && !commonPasswordListConfigured {
		return errors.New("ASVS requires AUTH_COMMON_PASSWORDS_FILE in production; set a newline-delimited top-3000 corpus")
	}
	if p.Level >= 2 && p.ContextPasswordScreening && production && !contextPasswordListConfigured {
		return errors.New("ASVS L2 requires AUTH_CONTEXT_PASSWORDS_FILE in production; set context-derived password entries of at least 8 bytes")
	}
	if p.Level >= 2 && production && p.BreachedPasswordScreening && !breachListConfigured {
		return errors.New("ASVS L2 requires AUTH_BREACHED_PASSWORDS_FILE in production")
	}
	if p.Level >= 2 && production && p.RequireMFAForSensitiveActions && !mfaEnabled {
		return errors.New("ASVS L2 requires AUTH_MFA_ENABLED=true in production")
	}
	if p.RequireMFAForApplicationAccess && requireMFAForApplicationAccess && !mfaEnabled {
		return errors.New("AUTH_MFA_REQUIRED_FOR_LOGIN=true requires AUTH_MFA_ENABLED=true")
	}
	if p.Level >= 2 && production && p.RequireMFAForApplicationAccess && !requireMFAForApplicationAccess {
		return errors.New("ASVS L2 requires AUTH_MFA_REQUIRED_FOR_LOGIN=true in production")
	}
	if p.Level >= 3 {
		return errors.New("ASVS L3 is not generated: a phishing-resistant WebAuthn/passkey adapter is required")
	}
	return nil
}
