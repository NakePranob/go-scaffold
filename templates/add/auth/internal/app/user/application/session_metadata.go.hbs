package application

import (
	"crypto/hmac"
	"crypto/sha256"
	"encoding/hex"
	"net"
	"regexp"
	"strings"
	"unicode"
)

// sessionMetadata is the safe public description of a refresh session. Raw
// User-Agent and IP values stay inside the auth store and never cross the
// application/HTTP boundary.
type sessionMetadata struct {
	DeviceKey      string
	DeviceType     string
	DeviceName     string
	DeviceModel    string
	BrowserName    string
	BrowserVersion string
	OSName         string
	OSVersion      string
}

var (
	androidPattern = regexp.MustCompile(`Android ([0-9._]+)`)
	androidModel   = regexp.MustCompile(`Android [^;]+;\s*([^;)]+)`)
	iosPattern     = regexp.MustCompile(`(?:CPU (?:iPhone )?OS|iPhone OS) ([0-9_]+)`)
	windowsPattern = regexp.MustCompile(`Windows NT ([0-9.]+)`)
	macPattern     = regexp.MustCompile(`Mac OS X ([0-9_]+)`)
	chromePattern  = regexp.MustCompile(`(?:Chrome|CriOS)/([0-9.]+)`)
	edgePattern    = regexp.MustCompile(`(?:Edg|Edge)/([0-9.]+)`)
	firefoxPattern = regexp.MustCompile(`(?:Firefox|FxiOS)/([0-9.]+)`)
	operaPattern   = regexp.MustCompile(`(?:OPR|Opera)/([0-9.]+)`)
	samsungPattern = regexp.MustCompile(`SamsungBrowser/([0-9.]+)`)
	versionPattern = regexp.MustCompile(`Version/([0-9.]+)`)
)

func describeSession(secret, userAgent, ipAddress string) sessionMetadata {
	deviceType, deviceName, deviceModel, osName, osVersion := describeDevice(userAgent)
	browserName, browserVersion := describeBrowser(userAgent)
	normalizedIP := normalizeIPAddress(ipAddress)
	return sessionMetadata{
		DeviceKey:      sessionDeviceKey(secret, deviceType, deviceName, deviceModel, osName, normalizedIP),
		DeviceType:     deviceType,
		DeviceName:     deviceName,
		DeviceModel:    deviceModel,
		BrowserName:    browserName,
		BrowserVersion: browserVersion,
		OSName:         osName,
		OSVersion:      osVersion,
	}
}

func (s *Service) metadataKey() string {
	if strings.TrimSpace(s.config.MetadataKey) != "" {
		return s.config.MetadataKey
	}
	// Compatibility for focused application tests and older hand-wired
	// projects. The generated production composition always supplies a
	// separate AUTH_METADATA_KEY and rejects the default/short value.
	return s.config.JWTSecret
}

func describeDevice(userAgent string) (deviceType, deviceName, deviceModel, osName, osVersion string) {
	ua := strings.ToLower(userAgent)
	deviceType, deviceName = "desktop", "Computer"
	osName = "Unknown OS"

	switch {
	case strings.Contains(ua, "ipad"):
		deviceType, deviceName, deviceModel = "tablet", "iPad", "iPad"
	case strings.Contains(ua, "iphone"):
		deviceType, deviceName, deviceModel = "mobile", "iPhone", "iPhone"
	case strings.Contains(ua, "android"):
		deviceType = "mobile"
		if !strings.Contains(ua, "mobile") {
			deviceType = "tablet"
		}
		deviceName = "Android"
		deviceModel = androidDeviceModel(userAgent)
	case strings.Contains(ua, "cros"):
		deviceName = "Chromebook"
	case strings.Contains(ua, "windows"):
		deviceName = "Windows PC"
	case strings.Contains(ua, "macintosh") || strings.Contains(ua, "mac os x"):
		deviceName = "Mac"
	case strings.Contains(ua, "linux"):
		deviceName = "Linux PC"
	}

	switch {
	case strings.Contains(ua, "android"):
		osName, osVersion = "Android", firstMatch(androidPattern, userAgent)
	case strings.Contains(ua, "iphone"), strings.Contains(ua, "ipad"):
		osName, osVersion = "iOS", normalizeVersion(firstMatch(iosPattern, userAgent))
	case strings.Contains(ua, "windows"):
		osName, osVersion = "Windows", windowsVersion(firstMatch(windowsPattern, userAgent))
	case strings.Contains(ua, "cros"):
		osName = "ChromeOS"
	case strings.Contains(ua, "mac os x"):
		osName, osVersion = "macOS", normalizeVersion(firstMatch(macPattern, userAgent))
	case strings.Contains(ua, "linux"):
		osName = "Linux"
	}
	return deviceType, deviceName, deviceModel, osName, osVersion
}

func describeBrowser(userAgent string) (name, version string) {
	ua := strings.ToLower(userAgent)
	switch {
	case strings.Contains(ua, "line/"):
		return "LINE", ""
	case strings.Contains(ua, "samsungbrowser/"):
		return "Samsung Internet", majorVersion(firstMatch(samsungPattern, userAgent))
	case strings.Contains(ua, "edg/") || strings.Contains(ua, "edge/"):
		return "Edge", majorVersion(firstMatch(edgePattern, userAgent))
	case strings.Contains(ua, "opr/") || strings.Contains(ua, "opera"):
		return "Opera", majorVersion(firstMatch(operaPattern, userAgent))
	case strings.Contains(ua, "firefox/") || strings.Contains(ua, "fxios/"):
		return "Firefox", majorVersion(firstMatch(firefoxPattern, userAgent))
	case strings.Contains(ua, "chrome/") || strings.Contains(ua, "crios/"):
		return "Chrome", majorVersion(firstMatch(chromePattern, userAgent))
	case strings.Contains(ua, "safari/"):
		return "Safari", majorVersion(firstMatch(versionPattern, userAgent))
	default:
		return "Unknown browser", ""
	}
}

func androidDeviceModel(userAgent string) string {
	model := firstMatch(androidModel, userAgent)
	model = strings.TrimSpace(strings.SplitN(model, " Build/", 2)[0])
	if model == "" || strings.EqualFold(model, "wv") {
		return ""
	}
	return safeDeviceModel(model)
}

func safeDeviceModel(value string) string {
	value = strings.Map(func(r rune) rune {
		if unicode.IsLetter(r) || unicode.IsNumber(r) || strings.ContainsRune(" .-_()", r) {
			return r
		}
		return -1
	}, value)
	runes := []rune(value)
	if len(runes) > 64 {
		return string(runes[:64])
	}
	return strings.TrimSpace(value)
}

func sessionDeviceKey(secret string, values ...string) string {
	mac := hmac.New(sha256.New, []byte(secret))
	_, _ = mac.Write([]byte(strings.Join(values, "|")))
	return hex.EncodeToString(mac.Sum(nil))
}

func firstMatch(pattern *regexp.Regexp, value string) string {
	match := pattern.FindStringSubmatch(value)
	if len(match) < 2 {
		return ""
	}
	return match[1]
}

func majorVersion(value string) string {
	if index := strings.IndexByte(value, '.'); index >= 0 {
		return value[:index]
	}
	return value
}

func normalizeVersion(value string) string {
	return strings.ReplaceAll(value, "_", ".")
}

func windowsVersion(value string) string {
	switch value {
	case "10.0":
		return "10/11"
	case "6.3":
		return "8.1"
	case "6.2":
		return "8"
	case "6.1":
		return "7"
	default:
		return value
	}
}

func normalizeIPAddress(value string) string {
	ip := net.ParseIP(strings.TrimSpace(value))
	if ip == nil {
		return ""
	}
	return ip.String()
}
