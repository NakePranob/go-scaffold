package application

import (
	"errors"
	"testing"

	"{{goModule}}/internal/app/user/domain"
)

func TestCommonPasswordPolicyRejectsCommonPassword(t *testing.T) {
	policy := NewCommonPasswordPolicy()
	if err := policy.Validate("password"); !errors.Is(err, domain.ErrInvalidPassword) {
		t.Fatalf("common password error = %v, want invalid password", err)
	}
}

func TestCommonPasswordPolicyAcceptsLongUniquePassword(t *testing.T) {
	policy := NewCommonPasswordPolicy()
	if err := policy.Validate("correct horse battery staple 2026!"); err != nil {
		t.Fatalf("unique password rejected: %v", err)
	}
}
