package application

import (
	"time"

	"{{goModule}}/internal/app/user/domain"

	"github.com/google/uuid"
)

type RegisterInput struct {
	Email    string
	Password string
	Name     string
	Session  SessionContext
}

type LoginInput struct {
	Email    string
	Password string
	Session  SessionContext
}

type LoginExchangeInput struct {
	Code         string
	State        string
	CodeVerifier string
	Session      SessionContext
}

type SessionContext struct {
	ID        uuid.UUID
	UserAgent string
	CreatedAt time.Time
}

type Session struct {
	ID         uuid.UUID
	UserAgent  string
	CreatedAt  time.Time
	LastUsedAt time.Time
	ExpiresAt  time.Time
	Current    bool
}

// IdentityResponse is the safe public view of a login identity. Provider
// subjects and password hashes never cross the application/HTTP boundary.
type IdentityResponse struct {
	ID        uuid.UUID
	Provider  string
	CreatedAt time.Time
}

func ToIdentityResponse(identity domain.Identity) IdentityResponse {
	return IdentityResponse{
		ID: identity.ID, Provider: string(identity.Provider), CreatedAt: identity.CreatedAt,
	}
}

type AuthResponse struct {
	AccessToken  string
	RefreshToken string
	TokenType    string
	ExpiresIn    int
}

type AuthResult struct {
	*AuthResponse
	MFAChallenge string
}

func TokenResult(auth *AuthResponse) *AuthResult {
	return &AuthResult{AuthResponse: auth}
}

func ChallengeResult(challenge string) *AuthResult {
	return &AuthResult{MFAChallenge: challenge}
}

// Response is the generic application response used by generated method
// extensions. Auth's HTTP adapter may expose a richer meResponse, but method
// generation still has one stable transport-neutral mapping seam.
type Response struct {
	ID            uuid.UUID
	Email         string
	Name          string
	AvatarURL     string
	EmailVerified bool
	Role          string
	CreatedAt     time.Time
	UpdatedAt     time.Time
}

func ToResponse(user *domain.User) Response {
	return Response{
		ID:            user.ID,
		Email:         user.Email,
		Name:          user.Name,
		AvatarURL:     user.AvatarURL,
		EmailVerified: user.EmailVerified,
		Role:          user.Role,
		CreatedAt:     user.CreatedAt,
		UpdatedAt:     user.UpdatedAt,
	}
}

