package ports

// PasswordHasher is the application-owned outbound contract for password
// storage and verification. The algorithm and cost policy belong to an
// adapter, not to the auth use cases.
type PasswordHasher interface {
	Hash(string) (string, error)
	Compare(hash, password string) error
}

// PasswordPolicy is the application-owned contract for password acceptance.
// The baseline policy is generated with the use cases; breach corpora remain
// an outbound adapter so operators can choose how they source and refresh it.
type PasswordPolicy interface {
	Validate(string) error
}
