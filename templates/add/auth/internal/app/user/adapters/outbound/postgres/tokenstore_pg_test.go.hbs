// tokenStoreDBForTest opens a real database instead of reusing the repository
// test transaction: concurrent consumers must use separate PostgreSQL
// connections to exercise DELETE ... RETURNING's row-level serialization.
func tokenStoreDBForTest(t *testing.T) *gorm.DB {
	t.Helper()
	dsn := os.Getenv("TEST_DB_DSN")
	if dsn == "" {
		if os.Getenv("REQUIRE_TEST_DB") == "true" {
			t.Fatal("TEST_DB_DSN is required when REQUIRE_TEST_DB=true")
		}
		t.Skip("token-store integration test skipped: set TEST_DB_DSN to a migrated PostgreSQL database")
	}

	db, err := gorm.Open(postgres.Open(dsn), &gorm.Config{TranslateError: true})
	if err != nil {
		if os.Getenv("REQUIRE_TEST_DB") == "true" {
			t.Fatalf("open required token-store database: %v", err)
		}
		t.Skipf("token-store integration test skipped: %v", err)
	}
	sqlDB, err := db.DB()
	if err != nil {
		t.Fatalf("get token-store SQL handle: %v", err)
	}
	if err := sqlDB.Ping(); err != nil {
		if os.Getenv("REQUIRE_TEST_DB") == "true" {
			t.Fatalf("ping required token-store database: %v", err)
		}
		t.Skipf("token-store integration test skipped: %v", err)
	}
	t.Cleanup(func() { _ = sqlDB.Close() })
	return db
}

func ensureTokenTestUser(t *testing.T, db *gorm.DB, userID uuid.UUID) {
	t.Helper()
	if err := db.Exec("INSERT INTO user_svc.users (id) VALUES (?) ON CONFLICT (id) DO NOTHING", userID).Error; err != nil {
		t.Fatalf("seed token test user: %v", err)
	}
	t.Cleanup(func() { _ = db.Exec("DELETE FROM user_svc.users WHERE id = ?", userID).Error })
}

func TestPgTokenStore_ConsumeRefreshToken_ConcurrentRealDatabase(t *testing.T) {
	db := tokenStoreDBForTest(t)
	store := NewPgTokenStore(db)
	ctx := context.Background()
	userID := uuid.New()
	ensureTokenTestUser(t, db, userID)
	hash := "real-pg-refresh-" + uuid.NewString()
	if err := store.SetRefreshToken(ctx, hash, refreshTokenRecordForTest(userID)); err != nil {
		t.Fatalf("seed refresh token: %v", err)
	}
	t.Cleanup(func() {
		_ = db.Exec("DELETE FROM user_svc.auth_tokens WHERE token_hash = ?", hash).Error
	})

	const callers = 32
	type result struct {
		token ports.RefreshTokenRecord
		ok    bool
		err   error
	}
	start := make(chan struct{})
	results := make(chan result, callers)
	for i := 0; i < callers; i++ {
		go func() {
			<-start
			token, ok, err := store.ConsumeRefreshToken(ctx, hash)
			results <- result{token: token, ok: ok, err: err}
		}()
	}
	close(start)

	winners := 0
	for i := 0; i < callers; i++ {
		got := <-results
		if got.err != nil {
			t.Fatalf("concurrent consume: %v", got.err)
		}
		if got.ok {
			winners++
			if got.token.UserID != userID {
				t.Fatalf("winner returned user %s, want %s", got.token.UserID, userID)
			}
		}
	}
	if winners != 1 {
		t.Fatalf("expected exactly one real-database refresh winner, got %d", winners)
	}
	if _, ok, err := store.GetRefreshToken(ctx, hash); err != nil || ok {
		t.Fatalf("consumed refresh token remained active: ok=%t err=%v", ok, err)
	}
}

func refreshTokenRecordForTest(userID uuid.UUID) ports.RefreshTokenRecord {
	now := time.Now()
	return ports.RefreshTokenRecord{UserID: userID, ExpiresAt: now.Add(time.Hour), AbsoluteExpiresAt: now.Add(24 * time.Hour)}
}

func TestPgTokenStore_ListAndRevokeRefreshSessions(t *testing.T) {
	db := tokenStoreDBForTest(t)
	store := NewPgTokenStore(db)
	ctx := context.Background()
	userID := uuid.New()
	ensureTokenTestUser(t, db, userID)
	currentID := uuid.New()
	remoteID := uuid.New()
	now := time.Now()
	hashes := []string{"real-pg-session-current-" + uuid.NewString(), "real-pg-session-remote-" + uuid.NewString()}
	for i, sessionID := range []uuid.UUID{currentID, remoteID} {
		if err := store.SetRefreshToken(ctx, hashes[i], ports.RefreshTokenRecord{
			UserID: userID, SessionID: sessionID, UserAgent: "test-device",
			IPAddress: []string{"203.0.113.10", "203.0.113.11"}[i],
			CreatedAt: now.Add(-time.Hour), LastUsedAt: now.Add(-time.Duration(i) * time.Minute),
			ExpiresAt: now.Add(time.Hour), AbsoluteExpiresAt: now.Add(24 * time.Hour),
		}); err != nil {
			t.Fatalf("seed session %d: %v", i, err)
		}
	}
	t.Cleanup(func() { _ = db.Exec("DELETE FROM user_svc.auth_tokens WHERE token_hash IN ?", hashes).Error })

	sessions, err := store.ListRefreshSessions(ctx, userID)
	if err != nil || len(sessions) != 2 {
		t.Fatalf("list sessions = %+v, err=%v", sessions, err)
	}
	if sessions[0].ID != currentID || sessions[0].UserAgent != "test-device" || sessions[0].IPAddress != "203.0.113.10" {
		t.Fatalf("sessions were not ordered/decoded correctly: %+v", sessions)
	}
	active, err := store.IsSessionActive(ctx, userID, currentID)
	if err != nil || !active {
		t.Fatalf("current session should be active: active=%t err=%v", active, err)
	}
	active, err = store.IsSessionActive(ctx, userID, remoteID)
	if err != nil || !active {
		t.Fatalf("remote session should be active: active=%t err=%v", active, err)
	}
	if err := store.RevokeRefreshSession(ctx, userID, remoteID); err != nil {
		t.Fatalf("revoke session: %v", err)
	}
	sessions, err = store.ListRefreshSessions(ctx, userID)
	if err != nil || len(sessions) != 1 || sessions[0].ID != currentID {
		t.Fatalf("sessions after revoke = %+v, err=%v", sessions, err)
	}
	active, err = store.IsSessionActive(ctx, userID, remoteID)
	if err != nil || active {
		t.Fatalf("revoked remote session should be inactive: active=%t err=%v", active, err)
	}
	active, err = store.IsSessionActive(ctx, userID, currentID)
	if err != nil || !active {
		t.Fatalf("current session should remain active: active=%t err=%v", active, err)
	}
}

func TestPgTokenStore_ReplacePasswordResetTokenKeepsOnlyNewestResetLink(t *testing.T) {
	db := tokenStoreDBForTest(t)
	store := NewPgTokenStore(db)
	ctx := context.Background()
	userID := uuid.New()
	otherUserID := uuid.New()
	ensureTokenTestUser(t, db, userID)
	ensureTokenTestUser(t, db, otherUserID)
	oldHash := "real-pg-reset-old-" + uuid.NewString()
	newHash := "real-pg-reset-new-" + uuid.NewString()
	otherHash := "real-pg-reset-other-" + uuid.NewString()
	verifyHash := "real-pg-verify-" + uuid.NewString()

	if err := store.SetPasswordResetToken(ctx, oldHash, userID, time.Hour); err != nil {
		t.Fatalf("seed old reset token: %v", err)
	}
	if err := store.SetPasswordResetToken(ctx, otherHash, otherUserID, time.Hour); err != nil {
		t.Fatalf("seed other-user reset token: %v", err)
	}
	if err := store.SetEmailVerifyToken(ctx, verifyHash, userID, time.Hour); err != nil {
		t.Fatalf("seed verification token: %v", err)
	}
	t.Cleanup(func() {
		_ = db.Exec("DELETE FROM user_svc.auth_tokens WHERE token_hash IN ?", []string{oldHash, newHash, otherHash, verifyHash}).Error
	})

	if err := store.ReplacePasswordResetToken(ctx, newHash, userID, time.Hour); err != nil {
		t.Fatalf("replace reset token: %v", err)
	}
	if _, ok, err := store.ConsumePasswordResetToken(ctx, oldHash); err != nil || ok {
		t.Fatalf("old reset token remained consumable: ok=%t err=%v", ok, err)
	}
	if got, ok, err := store.ConsumePasswordResetToken(ctx, newHash); err != nil || !ok || got != userID {
		t.Fatalf("new reset token = user=%s ok=%t err=%v, want user=%s and ok=true", got, ok, err, userID)
	}
	if got, ok, err := store.ConsumePasswordResetToken(ctx, otherHash); err != nil || !ok || got != otherUserID {
		t.Fatalf("other user's reset token = user=%s ok=%t err=%v, want user=%s and ok=true", got, ok, err, otherUserID)
	}
	if got, ok, err := store.ConsumeEmailVerifyToken(ctx, verifyHash); err != nil || !ok || got != userID {
		t.Fatalf("email verification token = user=%s ok=%t err=%v, want user=%s and ok=true", got, ok, err, userID)
	}
}

func TestPgTokenStore_SetRefreshTokenWithLimitEvictsOldestAtomically(t *testing.T) {
	db := tokenStoreDBForTest(t)
	store := NewPgTokenStore(db)
	ctx := context.Background()
	userID := uuid.New()
	ensureTokenTestUser(t, db, userID)
	oldestID := uuid.New()
	newerID := uuid.New()
	newID := uuid.New()
	now := time.Now()
	hashes := []string{
		"real-pg-session-limit-oldest-" + uuid.NewString(),
		"real-pg-session-limit-newer-" + uuid.NewString(),
		"real-pg-session-limit-new-" + uuid.NewString(),
	}
	for i, sessionID := range []uuid.UUID{oldestID, newerID} {
		lastUsedAt := now.Add(-time.Duration(2-i) * time.Hour)
		if err := store.SetRefreshToken(ctx, hashes[i], ports.RefreshTokenRecord{
			UserID: userID, SessionID: sessionID, CreatedAt: lastUsedAt, LastUsedAt: lastUsedAt,
			ExpiresAt: now.Add(time.Hour), AbsoluteExpiresAt: now.Add(24 * time.Hour),
		}); err != nil {
			t.Fatalf("seed session %d: %v", i, err)
		}
	}
	t.Cleanup(func() { _ = store.RevokeAllRefreshTokens(ctx, userID) })

	if err := store.SetRefreshTokenWithLimit(ctx, hashes[2], ports.RefreshTokenRecord{
		UserID: userID, SessionID: newID, CreatedAt: now, LastUsedAt: now,
		ExpiresAt: now.Add(time.Hour), AbsoluteExpiresAt: now.Add(24 * time.Hour),
	}, 2); err != nil {
		t.Fatalf("insert limited session: %v", err)
	}
	active, err := store.IsSessionActive(ctx, userID, oldestID)
	if err != nil || active {
		t.Fatalf("oldest session should be evicted: active=%t err=%v", active, err)
	}
	for _, sessionID := range []uuid.UUID{newerID, newID} {
		active, err := store.IsSessionActive(ctx, userID, sessionID)
		if err != nil || !active {
			t.Fatalf("session %s should remain active: active=%t err=%v", sessionID, active, err)
		}
	}
}
