// Package postgres contains the user module's PostgreSQL adapters and their
// persistence-only records. These types never cross into application code.
package postgres

import (
	"time"

	"github.com/google/uuid"
)

type User struct {
	ID        uuid.UUID `gorm:"type:uuid;primaryKey"`
	Name      string
	AvatarURL string
	Role      string `gorm:"type:varchar(20);not null;default:'staff'"`
	CreatedAt time.Time
	UpdatedAt time.Time
}

func (User) TableName() string { return "user_svc.users" }

type UserEmail struct {
	ID              uuid.UUID  `gorm:"type:uuid;primaryKey"`
	UserID          uuid.UUID  `gorm:"type:uuid;not null;index:idx_user_emails_user;uniqueIndex:idx_user_emails_primary,where:is_primary"`
	Email           string     `gorm:"type:varchar(255);not null"`
	EmailNormalized string     `gorm:"type:varchar(255);not null;uniqueIndex:idx_user_emails_normalized"`
	IsPrimary       bool       `gorm:"not null;default:true"`
	VerifiedAt      *time.Time
	CreatedAt       time.Time
	UpdatedAt       time.Time
}

func (UserEmail) TableName() string { return "user_svc.user_emails" }

type PasswordCredential struct {
	ID                  uuid.UUID `gorm:"type:uuid;primaryKey"`
	UserID              uuid.UUID `gorm:"type:uuid;not null;uniqueIndex:idx_password_credentials_user"`
	PasswordHash        string    `gorm:"column:password_hash;type:text;not null"`
	HashAlgorithm       string    `gorm:"type:varchar(32);not null;default:'bcrypt'"`
	PasswordChangedAt   time.Time `gorm:"not null"`
	CreatedAt           time.Time
	UpdatedAt           time.Time
}

func (PasswordCredential) TableName() string { return "user_svc.password_credentials" }

type ExternalIdentity struct {
	ID        uuid.UUID `gorm:"type:uuid;primaryKey"`
	UserID    uuid.UUID `gorm:"type:uuid;not null"`
	Provider  string    `gorm:"type:varchar(50);not null;uniqueIndex:idx_external_identities_user_provider,priority:2"`
	Issuer    string    `gorm:"type:text;not null;uniqueIndex:idx_external_identities_issuer_subject,priority:1"`
	Subject   string    `gorm:"type:text;not null;uniqueIndex:idx_external_identities_issuer_subject,priority:2"`
	CreatedAt time.Time
	UpdatedAt time.Time
}

func (ExternalIdentity) TableName() string { return "user_svc.external_identities" }

type AuthToken struct {
	TokenHash         string     `gorm:"primaryKey;type:text"`
	UserID            uuid.UUID  `gorm:"type:uuid;not null;index:idx_auth_tokens_user_kind,priority:1"`
	Kind              string     `gorm:"type:varchar(20);not null;index:idx_auth_tokens_user_kind,priority:2"`
	SessionID         uuid.UUID  `gorm:"type:uuid;not null;index:idx_auth_tokens_user_session,priority:1"`
	UserAgent         string     `gorm:"type:text;not null;default:''"`
	ExpiresAt         time.Time  `gorm:"not null;index:idx_auth_tokens_expires_at"`
	AbsoluteExpiresAt *time.Time `gorm:"index:idx_auth_tokens_absolute_expires_at"`
	Provider          string     `gorm:"type:varchar(20);not null;default:''"`
	CodeChallenge     string     `gorm:"type:text;not null;default:''"`
	Nonce             string     `gorm:"type:text;not null;default:''"`
	CreatedAt         time.Time  `gorm:"not null"`
	LastUsedAt        time.Time  `gorm:"not null;index:idx_auth_tokens_user_session,priority:3"`
}

func (AuthToken) TableName() string { return "user_svc.auth_tokens" }

type LoginThrottle struct {
	EmailHash   string `gorm:"primaryKey;type:text"`
	Failures    int    `gorm:"not null;default:0"`
	LockedUntil *time.Time
	UpdatedAt   time.Time
}

func (LoginThrottle) TableName() string { return "user_svc.login_throttle" }

type MFAEnrollment struct {
	UserID          uuid.UUID `gorm:"type:uuid;primaryKey"`
	EncryptedSecret string    `gorm:"type:text;not null"`
	Enabled         bool      `gorm:"not null;default:false"`
	CreatedAt       time.Time
	UpdatedAt       time.Time
}

func (MFAEnrollment) TableName() string { return "user_svc.mfa_enrollments" }

type MFAChallenge struct {
	ChallengeHash string    `gorm:"type:text;primaryKey"`
	UserID        uuid.UUID `gorm:"type:uuid;not null;index:idx_mfa_challenges_user"`
	SessionID     uuid.UUID `gorm:"type:uuid;not null;default:'00000000-0000-0000-0000-000000000000'"`
	UserAgent     string    `gorm:"type:text;not null;default:''"`
	ExpiresAt     time.Time `gorm:"not null;index:idx_mfa_challenges_expires_at"`
	CreatedAt     time.Time
}

func (MFAChallenge) TableName() string { return "user_svc.mfa_challenges" }

type MFARecoveryCode struct {
	UserID    uuid.UUID `gorm:"type:uuid;primaryKey;index:idx_mfa_recovery_codes_user"`
	CodeHash  string    `gorm:"type:text;primaryKey"`
	CreatedAt time.Time
}

func (MFARecoveryCode) TableName() string { return "user_svc.mfa_recovery_codes" }
