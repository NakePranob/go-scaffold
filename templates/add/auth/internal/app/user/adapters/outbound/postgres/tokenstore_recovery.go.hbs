package postgres

import (
	"context"
	"database/sql"
	"errors"
	"time"

	"{{goModule}}/internal/app/user/ports"
	"{{goModule}}/internal/shared/tx"

	"github.com/google/uuid"
	"gorm.io/gorm"
	"gorm.io/gorm/clause"
)

const (
	kindPasswordSet = "pwreset"
	kindEmailVerify = "emailverify"
)

// recoveryTokenStore is deliberately Postgres-backed for both auth store
// choices. Refresh rotation may live in Redis, but password reset and email
// verification must share a durable DB transaction with the user update.
type recoveryTokenStore struct {
	db *gorm.DB
}

var _ ports.RecoveryTokenStore = (*recoveryTokenStore)(nil)
var _ ports.ExpiredAuthStateStore = (*recoveryTokenStore)(nil)

func NewRecoveryTokenStore(db *gorm.DB) ports.RecoveryTokenStore {
	return newRecoveryTokenStore(db)
}

func newRecoveryTokenStore(db *gorm.DB) *recoveryTokenStore {
	return &recoveryTokenStore{db: db}
}

func (s *recoveryTokenStore) withTransaction(ctx context.Context, fn func(context.Context) error) error {
	return tx.Do(ctx, s.db, fn)
}

func (s *recoveryTokenStore) put(ctx context.Context, hash, kind string, userID uuid.UUID, ttl time.Duration) error {
	expiresAt := time.Now().Add(ttl)
	row := AuthToken{TokenHash: hash, UserID: authTokenUserID(userID), Kind: kind, ExpiresAt: expiresAt}
	return tx.From(ctx, s.db).WithContext(ctx).
		Where("token_hash = ?", hash).
		Assign(map[string]any{"user_id": authTokenUserID(userID), "kind": kind, "expires_at": expiresAt}).
		FirstOrCreate(&row).Error
}

func (s *recoveryTokenStore) consume(ctx context.Context, hash, kind string) (uuid.UUID, bool, error) {
	var userID uuid.UUID
	err := tx.From(ctx, s.db).WithContext(ctx).Raw(
		`DELETE FROM user_svc.auth_tokens
		 WHERE token_hash = ? AND kind = ? AND expires_at > now()
		 RETURNING user_id`, hash, kind).Row().Scan(&userID)
	if errors.Is(err, sql.ErrNoRows) {
		return uuid.Nil, false, nil
	}
	if err != nil {
		return uuid.Nil, false, err
	}
	return userID, true, nil
}

func (s *recoveryTokenStore) SetPasswordResetToken(ctx context.Context, tokenHash string, userID uuid.UUID, ttl time.Duration) error {
	return s.put(ctx, tokenHash, kindPasswordSet, userID, ttl)
}

// ReplacePasswordResetToken makes the newest recovery request the only
// outstanding password-reset link for the account. The user-row lock
// serializes concurrent requests for the same account; the delete and insert
// then commit together so a failed insert cannot leave the account without
// its previous working link.
func (s *recoveryTokenStore) ReplacePasswordResetToken(ctx context.Context, tokenHash string, userID uuid.UUID, ttl time.Duration) error {
	return s.withTransaction(ctx, func(txctx context.Context) error {
		db := tx.From(txctx, s.db).WithContext(txctx)
		var user User
		if err := db.Clauses(clause.Locking{Strength: "UPDATE"}).Where("id = ?", userID).First(&user).Error; err != nil {
			return err
		}
		if err := s.RevokePasswordResetTokens(txctx, userID); err != nil {
			return err
		}
		return s.put(txctx, tokenHash, kindPasswordSet, userID, ttl)
	})
}

// RestorePasswordResetTokenIfAbsent compensates for a cross-store session
// revoke failure without reviving an older link after a newer request won the
// user-row lock. It returns false when a live replacement already exists.
func (s *recoveryTokenStore) RestorePasswordResetTokenIfAbsent(ctx context.Context, tokenHash string, userID uuid.UUID, ttl time.Duration) (bool, error) {
	restored := false
	err := s.withTransaction(ctx, func(txctx context.Context) error {
		db := tx.From(txctx, s.db).WithContext(txctx)
		var user User
		if err := db.Clauses(clause.Locking{Strength: "UPDATE"}).Where("id = ?", userID).First(&user).Error; err != nil {
			return err
		}
		var count int64
		if err := db.Model(&AuthToken{}).
			Where("user_id = ? AND kind = ? AND expires_at > now()", authTokenUserID(userID), kindPasswordSet).
			Count(&count).Error; err != nil {
			return err
		}
		if count > 0 {
			return nil
		}
		if err := s.put(txctx, tokenHash, kindPasswordSet, userID, ttl); err != nil {
			return err
		}
		restored = true
		return nil
	})
	return restored, err
}

func (s *recoveryTokenStore) ConsumePasswordResetToken(ctx context.Context, tokenHash string) (uuid.UUID, bool, error) {
	return s.consume(ctx, tokenHash, kindPasswordSet)
}

// RevokePasswordResetTokens invalidates every other outstanding reset link
// after a successful password change. It runs on the caller's transaction so
// a failed password update leaves all reset tokens retryable.
func (s *recoveryTokenStore) RevokePasswordResetTokens(ctx context.Context, userID uuid.UUID) error {
	return tx.From(ctx, s.db).WithContext(ctx).
		Where("user_id = ? AND kind = ?", authTokenUserID(userID), kindPasswordSet).
		Delete(&AuthToken{}).Error
}

func (s *recoveryTokenStore) SetEmailVerifyToken(ctx context.Context, tokenHash string, userID uuid.UUID, ttl time.Duration) error {
	return s.put(ctx, tokenHash, kindEmailVerify, userID, ttl)
}

func (s *recoveryTokenStore) ConsumeEmailVerifyToken(ctx context.Context, tokenHash string) (uuid.UUID, bool, error) {
	return s.consume(ctx, tokenHash, kindEmailVerify)
}

func (s *recoveryTokenStore) WithTransaction(ctx context.Context, fn func(context.Context) error) error {
	return s.withTransaction(ctx, fn)
}

func (s *recoveryTokenStore) DeleteExpired(ctx context.Context) (int64, error) {
	result := tx.From(ctx, s.db).WithContext(ctx).
		Where("kind IN ? AND expires_at <= now()", []string{kindPasswordSet, kindEmailVerify}).
		Delete(&AuthToken{})
	return result.RowsAffected, result.Error
}
