const (
	legacyRefreshCookieName = "refresh_token"
	hostRefreshCookieName   = "__Host-refresh_token"
)

const PermUserManageRole = "user:manage-role"
const PermUserRead = "user:read"
const PermUserManageSession = "user:manage-session"
const PermUserManageStatus = "user:manage-status"

// go-scaffold:user-handler-consts

// authorizer is the optional capability RBAC supplies to protect admin
// routes. Auth itself does not import the RBAC middleware implementation.
type authorizer interface {
	Require(string) gin.HandlerFunc
}

type Handler struct {
	svc            application.ServicePort
	jwtSecret      string
	jwtIssuer      string
	jwtAudience    string
	refreshTTL     time.Duration
	oauthStateTTL  time.Duration
	cookieSecure   bool
	cookieSameSite string
	allowedOrigins []string
	// limiter, not a *redis.Client: which backing store counts the requests is
	// decided by `add auth --store`, and this file must not care.
	limiter middleware.Limiter
	authz   authorizer
	// go-scaffold:user-handler-fields
}

func NewHandler(
	svc application.ServicePort,
	jwtSecret string,
	refreshTTL time.Duration,
	cookieSecure bool,
	cookieSameSite string,
	limiter middleware.Limiter,
	authz ...authorizer,
	// go-scaffold:user-handler-params
) *Handler {
	return newHandler(svc, jwtSecret, "", "", refreshTTL, cookieSecure, cookieSameSite, nil, 10*time.Minute, limiter, authz...)
}

// NewHandlerWithOrigins is the composition entry point when the application
// uses cookies across browser origins.
func NewHandlerWithOrigins(
	svc application.ServicePort,
	jwtSecret string,
	refreshTTL time.Duration,
	cookieSecure bool,
	cookieSameSite string,
	allowedOrigins []string,
	limiter middleware.Limiter,
	authz ...authorizer,
	// go-scaffold:user-handler-with-origins-params
) *Handler {
	return newHandler(svc, jwtSecret, "", "", refreshTTL, cookieSecure, cookieSameSite, allowedOrigins, 10*time.Minute, limiter, authz...)
}

// NewHandlerWithOriginsAndOAuthTTL is the composition entry point when the
// application also supplies the configured OAuth state lifetime.
func NewHandlerWithOriginsAndOAuthTTL(
	svc application.ServicePort,
	jwtSecret string,
	refreshTTL time.Duration,
	cookieSecure bool,
	cookieSameSite string,
	allowedOrigins []string,
	oauthStateTTL time.Duration,
	limiter middleware.Limiter,
	authz ...authorizer,
	// go-scaffold:user-handler-with-origins-ttl-params
) *Handler {
