// NewHandlerWithOriginsAndOAuthTTLAndJWT is the production composition entry
// point. Issuer and audience prevent a token minted for another service that
// happens to share the signing secret from being accepted here.
func NewHandlerWithOriginsAndOAuthTTLAndJWT(
	svc application.ServicePort,
	jwtSecret string,
	jwtIssuer string,
	jwtAudience string,
	refreshTTL time.Duration,
	cookieSecure bool,
	cookieSameSite string,
	allowedOrigins []string,
	oauthStateTTL time.Duration,
	limiter middleware.Limiter,
	authz ...authorizer,
	// go-scaffold:user-handler-with-origins-ttl-jwt-params
) *Handler {
	return newHandler(svc, jwtSecret, jwtIssuer, jwtAudience, refreshTTL, cookieSecure, cookieSameSite, allowedOrigins, oauthStateTTL, limiter, authz...)
}

func newHandler(
	svc application.ServicePort,
	jwtSecret string,
	jwtIssuer string,
	jwtAudience string,
	refreshTTL time.Duration,
	cookieSecure bool,
	cookieSameSite string,
	allowedOrigins []string,
	oauthStateTTL time.Duration,
	limiter middleware.Limiter,
	authz ...authorizer,
) *Handler {
	var authzMiddleware authorizer
	if len(authz) > 0 {
		authzMiddleware = authz[0]
	}
	return &Handler{
		svc:            svc,
		jwtSecret:      jwtSecret,
		jwtIssuer:      jwtIssuer,
		jwtAudience:    jwtAudience,
		refreshTTL:     refreshTTL,
		oauthStateTTL:  oauthStateTTL,
		cookieSecure:   cookieSecure,
		cookieSameSite: cookieSameSite,
		allowedOrigins: append([]string(nil), allowedOrigins...),
		limiter:        limiter,
		authz:          authzMiddleware,
		// go-scaffold:user-handler-init
	}
}

// Register owns the public/protected route split for the user feature. The
// endpoint implementations live in focused handler files; this file remains
// the single route/composition surface that generator patches can target.
func (h *Handler) Register(rg gin.IRouter) {
	loginLimit := middleware.RateLimit(h.limiter, "login", 10, time.Minute)
	registerLimit := middleware.RateLimit(h.limiter, "register", 5, time.Minute)
	oauthLoginLimit := middleware.RateLimit(h.limiter, "oauth-login", 10, time.Minute)
	oauthExchangeLimit := middleware.RateLimit(h.limiter, "oauth-exchange", 10, time.Minute)
	forgotPasswordLimit := middleware.RateLimit(h.limiter, "forgot-password", 5, time.Minute)
	resetPasswordLimit := middleware.RateLimit(h.limiter, "reset-password", 10, time.Minute)
	verifyEmailLimit := middleware.RateLimit(h.limiter, "verify-email", 10, time.Minute)
	resendVerificationLimit := middleware.RateLimit(h.limiter, "resend-verification", 5, time.Minute)
	mfaVerifyLimit := middleware.RateLimit(h.limiter, "mfa-verify", 5, time.Minute)
	mfaEnrollmentLimit := middleware.RateLimit(h.limiter, "mfa-enrollment", 5, time.Minute)
	mfaSetupLimit := middleware.RateLimit(h.limiter, "mfa-setup", 5, time.Minute)
	mfaConfirmLimit := middleware.RateLimit(h.limiter, "mfa-confirm", 5, time.Minute)
	mfaDisableLimit := middleware.RateLimit(h.limiter, "mfa-disable", 5, time.Minute)
	mfaRecoveryLimit := middleware.RateLimit(h.limiter, "mfa-recovery", 5, time.Minute)
	identityLinkLimit := middleware.RateLimit(h.limiter, "identity-link", 10, time.Minute)
	reauthLimit := middleware.RateLimit(h.limiter, "reauth", 5, time.Minute)
	recentAuth := middleware.RequireRecentAuthWithIssuer(h.jwtSecret, h.jwtIssuer, h.jwtAudience)

	authGroup := rg.Group("/auth")
	authGroup.POST("/register", registerLimit, h.register)
	authGroup.POST("/login", loginLimit, h.login)
	authGroup.POST("/refresh", h.refresh)
	authGroup.POST("/logout", h.logout)
	authGroup.POST("/forgot-password", forgotPasswordLimit, h.forgotPassword)
	authGroup.POST("/reset-password", resetPasswordLimit, h.resetPassword)
	authGroup.POST("/verify-email", verifyEmailLimit, h.verifyEmail)
	authGroup.POST("/mfa/verify", mfaVerifyLimit, h.verifyMFA)
	authGroup.POST("/mfa/enroll/setup", mfaEnrollmentLimit, h.setupMFAEnrollment)
	authGroup.POST("/mfa/enroll/confirm", mfaEnrollmentLimit, h.confirmMFAEnrollment)
	authGroup.GET("/:provider/login", oauthLoginLimit, h.providerLogin)
	authGroup.POST("/:provider/exchange", oauthExchangeLimit, h.providerExchange)

	usersGroup := rg.Group("/users", middleware.RequireAuthWithIssuer(h.jwtSecret, h.jwtIssuer, h.jwtAudience, h.svc))
	usersGroup.GET("/me", h.me)
	usersGroup.POST("/me/resend-verification", resendVerificationLimit, h.resendVerification)
	usersGroup.POST("/me/reauth", reauthLimit, h.reauthenticate)
	usersGroup.POST("/me/password", reauthLimit, recentAuth, h.changePassword)
	usersGroup.POST("/me/logout-all", recentAuth, h.logoutAll)
	usersGroup.DELETE("/me", reauthLimit, recentAuth, h.disableMe)
	usersGroup.GET("/me/sessions", recentAuth, h.sessions)
	usersGroup.DELETE("/me/sessions/:id", recentAuth, h.revokeSession)
	usersGroup.GET("/me/mfa", h.mfaStatus)
	usersGroup.POST("/me/mfa/setup", mfaSetupLimit, recentAuth, h.setupMFA)
	usersGroup.POST("/me/mfa/confirm", mfaConfirmLimit, recentAuth, h.confirmMFA)
	usersGroup.POST("/me/mfa/disable", mfaDisableLimit, recentAuth, h.disableMFA)
	usersGroup.POST("/me/mfa/recover", mfaRecoveryLimit, h.recoverMFA)
	h.registerIdentityRoutes(usersGroup, identityLinkLimit, recentAuth)
	// Admin user routes are enabled only when the optional RBAC authorizer is
	// supplied by the composition root. Auth-only projects keep the endpoint
	// surface limited to authentication and the current-user operations.
	if h.authz != nil {
		usersGroup.GET("", h.authz.Require(PermUserRead), h.adminListUsers)
		usersGroup.GET("/:id", h.authz.Require(PermUserRead), h.adminGetUser)
		usersGroup.PATCH("/:id/set-role", h.authz.Require(PermUserManageRole), h.setRole)
		usersGroup.PATCH("/:id/status", h.authz.Require(PermUserManageStatus), recentAuth, h.setAccountStatus)
		usersGroup.DELETE("/:id/sessions/:session_id", h.authz.Require(PermUserManageSession), h.adminRevokeSession)
	}
	// go-scaffold:handler-routes
	// go-scaffold:user-routes
}

func (h *Handler) adminListUsers(c *gin.Context) {
	p := pagination.Parse(c)
	// One struct all the way down, so a filter added later is a field on
	// ports.ListFilter and not a new argument on the three signatures below.
	filter := ports.ListFilter{
		Search: p.Search,
		Sort:   p.Sort,
		Desc:   p.Desc,
		Limit:  p.Limit,
		Offset: p.Offset,
	}
	items, total, err := h.svc.List(c.Request.Context(), filter)
	if err != nil {
		c.Error(toHTTPError(err))
		return
	}
	out := make([]meResponse, len(items))
	for i := range items {
		out[i] = toMeResponse(&items[i])
	}
	c.JSON(http.StatusOK, p.ResponseWithTotal(out, total))
}
func (h *Handler) adminGetUser(c *gin.Context) {
	id, ok := httpx.ParseID(c)
	if !ok {
		return
	}
	u, err := h.svc.Get(c.Request.Context(), id)
	if err != nil {
		c.Error(toHTTPError(err))
		return
	}
	c.JSON(http.StatusOK, toMeResponse(u))
}
func (h *Handler) setRole(c *gin.Context) {
	id, ok := httpx.ParseID(c)
	if !ok {
		return
	}
	var in setRoleInput
	if err := c.ShouldBindJSON(&in); err != nil {
		c.Error(httpx.BindErr(err))
		return
	}
	u, err := h.svc.SetRole(c.Request.Context(), id, in.Role)
	if err != nil {
		c.Error(toHTTPError(err))
		return
	}
	c.JSON(http.StatusOK, toMeResponse(u))
}

func (h *Handler) setAccountStatus(c *gin.Context) {
	id, ok := httpx.ParseID(c)
	if !ok {
		return
	}
	var in setAccountStatusInput
	if err := c.ShouldBindJSON(&in); err != nil {
		c.Error(httpx.BindErr(err))
		return
	}
	if err := h.svc.SetAccountDisabled(c.Request.Context(), id, in.Disabled); err != nil {
		c.Error(toHTTPError(err))
		return
	}
	u, err := h.svc.Get(c.Request.Context(), id)
	if err != nil {
		c.Error(toHTTPError(err))
		return
	}
	c.JSON(http.StatusOK, toMeResponse(u))
}

func toHTTPError(err error) error {
	if err == nil {
		return nil
	}
	var appErr *apperror.AppError
	if errors.As(err, &appErr) {
		return err
	}
	var ruleErr *domain.RuleError
	if errors.As(err, &ruleErr) {
		status := http.StatusInternalServerError
		switch ruleErr.Code {
		case "USER_NOT_FOUND":
			status = http.StatusNotFound
		case "USER_EMAIL_TAKEN", "AUTH_ALREADY_VERIFIED", "AUTH_MFA_ALREADY_ENABLED", "AUTH_MFA_NOT_ENROLLED", "AUTH_MFA_SETUP_REQUIRED", "AUTH_IDENTITY_ALREADY_LINKED", "AUTH_IDENTITY_CONFLICT", "AUTH_LAST_IDENTITY":
			status = http.StatusConflict
		case "AUTH_IDENTITY_NOT_FOUND":
			status = http.StatusNotFound
		case "AUTH_INVALID_CREDENTIALS", "AUTH_INVALID_TOKEN", "AUTH_MFA_INVALID":
			status = http.StatusUnauthorized
		case "AUTH_INVALID_PASSWORD":
			status = http.StatusBadRequest
		case "AUTH_REAUTH_REQUIRED", "AUTH_LOCAL_IDENTITY_REQUIRED":
			status = http.StatusForbidden
		case "AUTH_MFA_UNAVAILABLE":
			status = http.StatusServiceUnavailable
		case "AUTH_TOO_MANY_ATTEMPTS":
			status = http.StatusTooManyRequests
		case "USER_UNKNOWN_ROLE":
			status = http.StatusUnprocessableEntity
		}
		return apperror.New(status, ruleErr.Code, ruleErr.Message)
	}
	// Before the catch-all: a stub `generate method` wrote has no body yet and
	// 501 says so, where NewInternal would report a server fault for a route
	// nobody has written.
	if errors.Is(err, domain.ErrNotImplemented) {
		return apperror.New(http.StatusNotImplemented, "NOT_IMPLEMENTED", "not implemented")
	}
	if errors.Is(err, domain.ErrNotFound) {
		return apperror.NewNotFound("user not found")
	}
	return apperror.NewInternal(err)
}

