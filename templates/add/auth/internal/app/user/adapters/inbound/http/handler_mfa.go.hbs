func (h *Handler) confirmMFA(c *gin.Context) {
	setNoStoreHeaders(c)
	if !h.requireBrowserOrigin(c) {
		return
	}
	var in mfaCodeInput
	if err := c.ShouldBindJSON(&in); err != nil {
		c.Error(httpx.BindErr(err))
		return
	}
	codes, err := h.svc.ConfirmMFA(c.Request.Context(), currentUserID(c), in.Code)
	if err != nil {
		c.Error(toHTTPError(err))
		return
	}
	c.JSON(http.StatusOK, mfaConfirmResponse{RecoveryCodes: codes})
}

func (h *Handler) recoverMFA(c *gin.Context) {
	setNoStoreHeaders(c)
	if !h.requireBrowserOrigin(c) {
		return
	}
	var in mfaCodeInput
	if err := c.ShouldBindJSON(&in); err != nil {
		c.Error(httpx.BindErr(err))
		return
	}
	token, err := h.svc.RecoverMFA(c.Request.Context(), currentUserID(c), in.Code)
	if err != nil {
		c.Error(toHTTPError(err))
		return
	}
	c.JSON(http.StatusOK, mfaRecoveryResponse{
		MFARecoveryStarted: true,
		EnrollmentToken:    token,
	})
}

func (h *Handler) disableMFA(c *gin.Context) {
	setNoStoreHeaders(c)
	if !h.requireBrowserOrigin(c) {
		return
	}
	var in mfaCodeInput
	if err := c.ShouldBindJSON(&in); err != nil {
		c.Error(httpx.BindErr(err))
		return
	}
	if err := h.svc.DisableMFA(c.Request.Context(), currentUserID(c), in.Code); err != nil {
		c.Error(toHTTPError(err))
		return
	}
	c.Status(http.StatusNoContent)
}

func currentUserID(c *gin.Context) uuid.UUID {
	return c.MustGet(middleware.UserIDKey).(uuid.UUID)
}

func currentSessionID(c *gin.Context) uuid.UUID {
	if value, ok := c.Get(middleware.SessionIDKey); ok {
		if sessionID, ok := value.(uuid.UUID); ok {
			return sessionID
		}
	}
	return uuid.Nil
}
