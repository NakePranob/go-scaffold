package httpadapter

import (
	"net/http"

	"{{goModule}}/internal/shared/httpx"
	"{{goModule}}/internal/shared/middleware"

	"github.com/gin-gonic/gin"
	"github.com/google/uuid"
)

func (h *Handler) verifyMFA(c *gin.Context) {
	setNoStoreHeaders(c)
	if !h.requireBrowserOrigin(c) {
		return
	}
	var in mfaChallengeInput
	if err := c.ShouldBindJSON(&in); err != nil {
		c.Error(httpx.BindErr(err))
		return
	}
	auth, err := h.svc.VerifyMFA(c.Request.Context(), in.Challenge, in.Code, c.ClientIP())
	if err != nil {
		c.Error(toHTTPError(err))
		return
	}
	h.setRefreshCookie(c, auth.RefreshToken)
	c.JSON(http.StatusOK, toCookieResponse(auth))
}

func (h *Handler) setupMFAEnrollment(c *gin.Context) {
	setNoStoreHeaders(c)
	if !h.requireBrowserOrigin(c) {
		return
	}
	var in mfaEnrollmentSetupInput
	if err := c.ShouldBindJSON(&in); err != nil {
		c.Error(httpx.BindErr(err))
		return
	}
	setup, err := h.svc.SetupMFAEnrollment(c.Request.Context(), in.EnrollmentToken)
	if err != nil {
		c.Error(toHTTPError(err))
		return
	}
	c.JSON(http.StatusOK, mfaSetupResponse{Secret: setup.Secret, OTPAuthURI: setup.OTPAuthURI})
}

func (h *Handler) confirmMFAEnrollment(c *gin.Context) {
	setNoStoreHeaders(c)
	if !h.requireBrowserOrigin(c) {
		return
	}
	var in mfaEnrollmentConfirmInput
	if err := c.ShouldBindJSON(&in); err != nil {
		c.Error(httpx.BindErr(err))
		return
	}
	codes, auth, err := h.svc.ConfirmMFAEnrollment(c.Request.Context(), in.EnrollmentToken, in.Code, sessionContext(c.GetHeader("User-Agent"), c.ClientIP()))
	if err != nil {
		c.Error(toHTTPError(err))
		return
	}
	h.setRefreshCookie(c, auth.RefreshToken)
	c.JSON(http.StatusOK, mfaEnrollmentConfirmResponse{
		AccessToken: auth.AccessToken,
		TokenType: auth.TokenType,
		ExpiresIn: auth.ExpiresIn,
		RecoveryCodes: codes,
	})
}

func (h *Handler) mfaStatus(c *gin.Context) {
	setNoStoreHeaders(c)
	status, err := h.svc.MFAStatus(c.Request.Context(), currentUserID(c))
	if err != nil {
		c.Error(toHTTPError(err))
		return
	}
	c.JSON(http.StatusOK, mfaStatusResponse(status))
}

