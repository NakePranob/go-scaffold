	setNoStoreHeaders(c)
	if !h.requireBrowserOrigin(c) {
		return
	}
	setup, err := h.svc.SetupMFA(c.Request.Context(), currentUserID(c))
	if err != nil {
		c.Error(toHTTPError(err))
		return
	}
	c.JSON(http.StatusOK, mfaSetupResponse{Secret: setup.Secret, OTPAuthURI: setup.OTPAuthURI})
