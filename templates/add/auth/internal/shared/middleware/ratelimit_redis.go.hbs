package middleware

import (
	"context"
	"time"

	"github.com/redis/go-redis/v9"
)

// RedisLimiter shares one counter across every replica, so `limit` means the
// same thing whether you run one pod or ten. It ships alongside the Redis
// token store (`add auth --store redis`).
type RedisLimiter struct {
	rdb *redis.Client
}

func NewRedisLimiter(rdb *redis.Client) *RedisLimiter { return &RedisLimiter{rdb: rdb} }

// allowScript increments the counter and applies its expiry in one Redis
// operation. A crash between separate INCR and EXPIRE commands could otherwise
// leave a key with no TTL, turning a transient first request into a permanent
// lockout.
var allowScript = redis.NewScript(`
local count = redis.call("INCR", KEYS[1])
if count == 1 or redis.call("PTTL", KEYS[1]) < 0 then
  redis.call("PEXPIRE", KEYS[1], ARGV[1])
end
return count
`)

func (r *RedisLimiter) Allow(ctx context.Context, key string, limit int, window time.Duration) (bool, error) {
	redisKey := "ratelimit:" + key

	ttl := window.Milliseconds()
	if ttl < 1 {
		ttl = 1
	}
	count, err := allowScript.Run(ctx, r.rdb, []string{redisKey}, ttl).Int64()
	if err != nil {
		return false, err
	}
	return count <= int64(limit), nil
}
